<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        PPh withholding rate matrix, Indonesian statutory rates.

        noupdate="1" on purpose: a tenant may amend a rate (a tax-treaty rate
        for PPh 26, a construction qualification that differs), and an upgrade
        must not silently overwrite that. New rates ship as new records with a
        later effective_date_from; _find_active() picks the most recent one
        that covers the date, so a rate change is additive, never destructive.

        without_npwp_rate follows the statute, NOT a blanket doubling:
          * PPh 23  -> 100% higher without NPWP (UU PPh Pasal 23 ayat (1a))
          * PPh 22  -> 100% higher without NPWP (UU PPh Pasal 22 ayat (3))
          * PPh 21  -> 20% higher without NPWP  (UU PPh Pasal 21 ayat (5a))
          * PPh 4(2) -> FINAL; no NPWP surcharge exists, so both columns match
          * PPh 15  -> final regime; no NPWP surcharge
          * PPh 26  -> 20% statutory; a lower tax-treaty rate needs a DGT form
                       and is a per-partner decision, not a default
        Rates are percentages of the gross amount (engine multiplies by /100).
    -->

    <!-- ================================================================
         PPh Pasal 23 - UU PPh Pasal 23 ayat (1); PMK 141/PMK.03/2015
         ================================================================ -->
    <record id="rate_pph23_general" model="custom.witholding.rate">
        <field name="pph_type">23</field>
        <field name="service_category">general</field>
        <field name="with_npwp_rate">2.0</field>
        <field name="without_npwp_rate">4.0</field>
        <field name="effective_date_from">2009-01-01</field>
        <field name="legal_basis">UU PPh Pasal 23 ayat (1) huruf c angka 2 jo. PMK 141/PMK.03/2015 — imbalan jasa lain, 2% dari jumlah bruto tidak termasuk PPN. Tanpa NPWP: 100% lebih tinggi (Pasal 23 ayat (1a)).</field>
    </record>

