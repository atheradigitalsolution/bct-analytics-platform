    <!-- ================================================================
         PPh Pasal 21 - 20% higher without NPWP (Pasal 21 ayat (5a)).
         The progressive employee schedule lives in custom_hr_payroll_id;
         this record covers the flat non-employee case.
         ================================================================ -->
    <record id="rate_pph21_bukan_pegawai" model="custom.witholding.rate">
