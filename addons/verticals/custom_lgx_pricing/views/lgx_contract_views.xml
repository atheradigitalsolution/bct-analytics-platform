<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lgx_contract_list" model="ir.ui.view">
        <field name="name">lgx.contract.list</field>
        <field name="model">lgx.contract</field>
        <field name="arch" type="xml">
            <list string="Kontrak">
                <field name="name"/>
                <field name="title"/>
                <field name="partner_id"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="credit_limit"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_lgx_contract_form" model="ir.ui.view">
        <field name="name">lgx.contract.form</field>
        <field name="model">lgx.contract</field>
        <field name="arch" type="xml">
            <form string="Kontrak">
                <header>
                    <button name="action_activate" type="object" string="Aktifkan"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_terminate" type="object" string="Putuskan"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3><field name="title" placeholder="Judul kontrak"/></h3>
                    </div>
                    <group>
                        <group string="Pihak &amp; Masa">
                            <field name="partner_id"/>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Syarat Komersial">
                            <field name="payment_term_id"/>
                            <field name="currency_id"/>
                            <field name="credit_limit"/>
                            <field name="minimum_monthly_charge"/>
                            <field name="volume_commitment"/>
                            <field name="volume_commitment_uom"/>
                        </group>
                    </group>
                    <group>
                        <group string="Masa Bebas">
                            <field name="free_days_demurrage"/>
                            <field name="free_days_detention"/>
                            <field name="free_days_storage"/>
                        </group>
                        <group string="Meterai">
                            <field name="requires_stamp_duty"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rate Card">
                            <field name="rate_card_ids" widget="many2many">
                                <list>
                                    <field name="name"/>
                                    <field name="transport_mode"/>
                                    <field name="origin_id"/>
                                    <field name="destination_id"/>
                                    <field name="valid_from"/>
                                    <field name="valid_to"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="SLA"><field name="sla_note" nolabel="1"/></page>
                        <page string="Dokumen">
                            <field name="document_ids" widget="many2many_binary" nolabel="1"/>
                        </page>
                        <page string="Catatan"><field name="note" nolabel="1"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_lgx_contract" model="ir.actions.act_window">
        <field name="name">Kontrak</field>
        <field name="res_model">lgx.contract</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
