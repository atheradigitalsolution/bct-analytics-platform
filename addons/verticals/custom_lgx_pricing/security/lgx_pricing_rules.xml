<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_lgx_rate_card_company" model="ir.rule">
            <field name="name">Rate card: per perusahaan</field>
            <field name="model_id" ref="model_lgx_rate_card"/>
            <field name="domain_force">[('company_id','in',company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_lgx_quote_company" model="ir.rule">
            <field name="name">Penawaran: per perusahaan</field>
            <field name="model_id" ref="model_lgx_quote"/>
            <field name="domain_force">[('company_id','in',company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_lgx_contract_company" model="ir.rule">
            <field name="name">Kontrak: per perusahaan</field>
            <field name="model_id" ref="model_lgx_contract"/>
            <field name="domain_force">[('company_id','in',company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
