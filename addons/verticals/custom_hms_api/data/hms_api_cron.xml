<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_hms_api_token_gc" model="ir.cron">
            <field name="name">SIMRS: bersihkan refresh token kedaluwarsa</field>
            <field name="model_id" ref="model_hms_api_token"/>
            <field name="state">code</field>
            <field name="code">model._gc()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_hms_api_idempotency_gc" model="ir.cron">
            <field name="name">SIMRS: bersihkan kunci idempotency kedaluwarsa</field>
            <field name="model_id" ref="model_hms_api_idempotency"/>
            <field name="state">code</field>
            <field name="code">model._gc()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
