<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hms_api_token_list" model="ir.ui.view">
        <field name="name">hms.api.token.list</field>
        <field name="model">hms.api.token</field>
        <field name="arch" type="xml">
            <list string="Refresh Token" create="false" edit="false">
                <field name="user_id"/>
                <field name="issued_at"/>
                <field name="expires_at"/>
                <field name="revoked"/>
                <field name="ip_address"/>
                <field name="user_agent" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_hms_api_token" model="ir.actions.act_window">
        <field name="name">Sesi API Aktif</field>
        <field name="res_model">hms.api.token</field>
        <field name="view_mode">list</field>
        <field name="domain">[('revoked', '=', False)]</field>
    </record>
    <menuitem id="menu_hms_api_token" name="Sesi API"
              parent="custom_hms_queue.menu_hms_integration" action="action_hms_api_token"
              sequence="60"/>
</odoo>
