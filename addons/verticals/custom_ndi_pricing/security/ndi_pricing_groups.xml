<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Kasir: Harga 1-3 saja (pasal 22). -->
        <record id="ndi_group_price_1_3" model="res.groups">
            <field name="name">NDI Feed Mill / Harga 1-3 (Kasir)</field>
            <field name="privilege_id" ref="custom_ndi_master.res_groups_privilege_ndi"/>
            <field name="comment">Hanya boleh membaca pricelist Harga 1 sampai Harga 3. Berlaku di POS, backend dan RPC sekaligus.</field>
        </record>

        <!-- Owner / Admin: seluruh sembilan tingkat. -->
        <record id="ndi_group_price_1_9" model="res.groups">
            <field name="name">NDI Feed Mill / Harga 1-9 (Owner)</field>
            <field name="privilege_id" ref="custom_ndi_master.res_groups_privilege_ndi"/>
            <field name="comment">Boleh membaca sembilan tingkat harga dan merawat matriks harga.</field>
            <field name="implied_ids" eval="[(4, ref('custom_ndi_master.group_ndi_master_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
