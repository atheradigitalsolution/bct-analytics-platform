<?xml version="1.0" encoding="utf-8"?>
<!--
    Batas tingkat harga per PENGGUNA (keputusan D6).

    Bukan lewat `pos.config.available_pricelist_ids`, karena itu batas per
    terminal: satu mesin kasir yang dipakai bergantian kasir dan owner akan
    memaksa dua terminal dan dua sesi kas. `ir.rule` di `product.pricelist`
    ikut menyaring layar POS, karena `product.pricelist._load_pos_data_read()`
    memanggil `_filtered_access("read")` sebelum membaca.

    Domain kasir menyembunyikan Harga 4-9 dan TIDAK menyembunyikan pricelist di
    luar matriks NDI (mis. "Default" bawaan). Menyembunyikan semuanya akan
    membuat terminal POS yang masih memakai pricelist bawaan gagal memuat harga
    sama sekali — gejala yang muncul sebagai "POS blank", jauh dari penyebabnya.

    Perhatikan: pengguna yang tidak ada di grup mana pun tidak terkena rule sama
    sekali dan melihat semuanya. Itu perilaku ir.rule Odoo, bukan kebocoran modul
    ini; kasir harus benar-benar dimasukkan ke grup Harga 1-3.
-->
<odoo>
    <data noupdate="1">
        <record id="rule_pricelist_tier_basic" model="ir.rule">
            <field name="name">NDI: kasir hanya Harga 1-3</field>
            <field name="model_id" ref="product.model_product_pricelist"/>
            <field name="groups" eval="[(4, ref('ndi_group_price_1_3'))]"/>
            <field name="domain_force">['|', ('ndi_hj_level', '=', False), ('ndi_hj_level', '&lt;', 4)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_pricelist_tier_full" model="ir.rule">
            <field name="name">NDI: owner melihat Harga 1-9</field>
            <field name="model_id" ref="product.model_product_pricelist"/>
            <field name="groups" eval="[(4, ref('ndi_group_price_1_9'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
