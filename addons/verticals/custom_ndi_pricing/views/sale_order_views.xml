<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_ndi" model="ir.ui.view">
        <field name="name">sale.order.form.ndi</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="before">
                <field name="ndi_hj_level" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
