<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_pricelist_form_ndi" model="ir.ui.view">
        <field name="name">product.pricelist.form.ndi</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <field name="currency_id" position="after">
                <field name="ndi_hj_level"/>
            </field>
        </field>
    </record>

    <record id="view_product_pricelist_list_ndi" model="ir.ui.view">
        <field name="name">product.pricelist.list.ndi</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="ndi_hj_level" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
