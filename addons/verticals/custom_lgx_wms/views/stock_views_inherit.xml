<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_lgx_wms" model="ir.ui.view">
        <field name="name">stock.picking.form.lgx.wms</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="lgx_wms_client_id"/>
                <field name="lgx_job_id"/>
            </field>
        </field>
    </record>
    <record id="view_product_category_form_lgx" model="ir.ui.view">
        <field name="name">product.category.form.lgx</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="lgx_is_client_goods"/>
            </field>
        </field>
    </record>
    <record id="action_lgx_stock_by_client" model="ir.actions.act_window">
        <field name="name">Stok per Pemilik Barang</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('lgx_wms_client_id','!=',False)]</field>
        <field name="context">{'search_default_group_lgx_client': 1}</field>
    </record>
    <record id="view_stock_quant_search_lgx" model="ir.ui.view">
        <field name="name">stock.quant.search.lgx</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view"/>
        <field name="arch" type="xml">
            <search position="inside">
                <field name="lgx_wms_client_id"/>
                <filter name="group_lgx_client" string="Pemilik Barang"
                        context="{'group_by':'lgx_wms_client_id'}"/>
            </search>
        </field>
    </record>
</odoo>
