<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_hms_generate_slots" model="ir.cron">
            <field name="name">SIMRS: buat slot jadwal 7 hari ke depan</field>
            <field name="model_id" ref="model_hms_schedule_template"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_slots()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_hms_followup_missed" model="ir.cron">
            <field name="name">SIMRS: tandai rencana kontrol yang tidak datang</field>
            <field name="model_id" ref="model_hms_followup_plan"/>
            <field name="state">code</field>
            <field name="code">model._cron_mark_missed()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
