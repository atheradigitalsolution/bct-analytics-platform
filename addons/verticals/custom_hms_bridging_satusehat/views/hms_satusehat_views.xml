<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hms_encounter_form_satusehat" model="ir.ui.view">
        <field name="name">hms.encounter.form.satusehat</field>
        <field name="model">hms.encounter</field>
        <field name="inherit_id" ref="custom_hms_registration.view_hms_encounter_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="action_push_satusehat" type="object"
                        string="Kirim ke SATUSEHAT"
                        groups="custom_hms_base.group_hms_admin"
                        invisible="state == 'cancelled'"/>
            </xpath>
        </field>
    </record>
</odoo>
