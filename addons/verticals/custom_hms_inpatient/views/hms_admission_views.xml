<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hms_admission_list" model="ir.ui.view">
        <field name="name">hms.admission.list</field>
        <field name="model">hms.admission</field>
        <field name="arch" type="xml">
            <list string="Admisi Rawat Inap" decoration-muted="state in ('discharged', 'cancelled')">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="admitted_at"/>
                <field name="length_of_stay" string="Hari"/>
                <field name="ward_id"/>
                <field name="room_id"/>
                <field name="bed_id"/>
                <field name="class_id"/>
                <field name="entitled_class_id" optional="show"/>
                <field name="dpjp_id"/>
                <field name="payer_id" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_hms_admission_form" model="ir.ui.view">
        <field name="name">hms.admission.form</field>
        <field name="model">hms.admission</field>
        <field name="arch" type="xml">
            <form string="Admisi">
                <header>
                    <button name="action_plan_discharge" type="object" string="Rencana Pulang"
                            invisible="state != 'admitted'"/>
                    <button name="action_discharge" type="object" string="Pulangkan"
                            class="btn-primary" invisible="state not in ('admitted', 'discharge_planned')"/>
                    <button name="action_cancel" type="object" string="Batalkan Admisi"
                            invisible="state in ('discharged', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="admitted,discharge_planned,discharged"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Pasien">
                            <field name="encounter_id" readonly="1"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="payer_id" readonly="1"/>
                            <field name="source"/>
                            <field name="dpjp_id"/>
                        </group>
                        <group string="Penempatan">
                            <field name="ward_id" readonly="1"/>
                            <field name="room_id" readonly="1"/>
                            <field name="bed_id" readonly="1"/>
                            <field name="class_id" readonly="1"/>
                            <field name="entitled_class_id"/>
                            <field name="admitted_at"/>
                            <field name="discharged_at" readonly="1"/>
                            <field name="length_of_stay" readonly="1"/>
                        </group>
                    </group>
                    <group string="Perawatan">
                        <group>
                            <field name="diet_type_id"/>
                            <field name="diet"/>
                            <field name="is_isolation"/>
                        </group>
                        <group>
                            <field name="discharge_disposition"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Riwayat Bed">
                            <field name="assignment_ids" readonly="1">
                                <list>
                                    <field name="from_at"/>
                                    <field name="to_at"/>
                                    <field name="ward_id"/>
                                    <field name="bed_id"/>
                                    <field name="class_id"/>
                                    <field name="charge_class_id"/>
                                    <field name="reason"/>
                                    <field name="is_current"/>
                                </list>
                            </field>
                        </page>
                        <page string="Charge Harian">
                            <field name="daily_charge_ids" readonly="1">
                                <list>
                                    <field name="charge_date"/>
                                    <field name="charge_type"/>
                                    <field name="tariff_id"/>
                                    <field name="class_id"/>
                                    <field name="practitioner_id"/>
                                    <field name="qty"/>
                                </list>
                            </field>
                        </page>
                        <page string="Catatan">
                            <field name="discharge_note"/>
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_hms_admission_search" model="ir.ui.view">
        <field name="name">hms.admission.search</field>
        <field name="model">hms.admission</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="ward_id"/>
                <field name="dpjp_id"/>
                <filter name="f_active" string="Sedang Dirawat"
                        domain="[('state', 'in', ('admitted', 'discharge_planned'))]"/>
                <filter name="f_plan" string="Rencana Pulang"
                        domain="[('state', '=', 'discharge_planned')]"/>
                <separator/>
                <filter name="g_ward" string="Ruang" context="{'group_by': 'ward_id'}"/>
                <filter name="g_class" string="Kelas" context="{'group_by': 'class_id'}"/>
                <filter name="g_dpjp" string="DPJP" context="{'group_by': 'dpjp_id'}"/>
            </search>
        </field>
    </record>
    <record id="action_hms_admission" model="ir.actions.act_window">
        <field name="name">Admisi Rawat Inap</field>
        <field name="res_model">hms.admission</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hms_admission_search"/>
        <field name="context">{'search_default_f_active': 1, 'search_default_g_ward': 1}</field>
    </record>
    <menuitem id="menu_hms_admission" name="Pasien Dirawat"
              parent="custom_hms_base.menu_hms_inpatient_root" action="action_hms_admission"
              sequence="10"/>

    <record id="action_hms_daily_charge_rule" model="ir.actions.act_window">
        <field name="name">Aturan Charge Harian</field>
        <field name="res_model">hms.daily.charge.rule</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_hms_daily_charge_rule" name="Aturan Charge Harian"
              parent="custom_hms_base.menu_hms_config_tariff"
              action="action_hms_daily_charge_rule" sequence="40"/>

    <!-- ================= Master jenis diet ================= -->
    <record id="view_hms_diet_type_list" model="ir.ui.view">
        <field name="name">hms.diet.type.list</field>
        <field name="model">hms.diet.type</field>
        <field name="arch" type="xml">
            <list string="Jenis Diet">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="texture"/>
                <field name="energy_kcal"/>
                <field name="protein_g"/>
                <field name="is_therapeutic"/>
            </list>
        </field>
    </record>
    <record id="view_hms_diet_type_form" model="ir.ui.view">
        <field name="name">hms.diet.type.form</field>
        <field name="model">hms.diet.type</field>
        <field name="arch" type="xml">
            <form string="Jenis Diet">
                <sheet>
                    <widget name="web_ribbon" title="Diarsipkan" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="texture"/>
                            <field name="is_therapeutic"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="energy_kcal"/>
                            <field name="protein_g"/>
                        </group>
                    </group>
                    <separator string="Pantangan"/>
                    <field name="restrictions"
                           placeholder="Mis. tanpa gula sederhana, garam maksimal 2 g/hari."/>
                    <separator string="Catatan"/>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_hms_diet_type_search" model="ir.ui.view">
        <field name="name">hms.diet.type.search</field>
        <field name="model">hms.diet.type</field>
        <field name="arch" type="xml">
            <search string="Jenis Diet">
                <field name="code"/>
                <field name="name"/>
                <filter name="f_therapeutic" string="Terapeutik"
                        domain="[('is_therapeutic', '=', True)]"/>
                <filter name="f_archived" string="Diarsipkan" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="g_category" string="Kategori" context="{'group_by': 'category'}"/>
                <filter name="g_texture" string="Tekstur" context="{'group_by': 'texture'}"/>
            </search>
        </field>
    </record>
    <record id="action_hms_diet_type" model="ir.actions.act_window">
        <field name="name">Jenis Diet</field>
        <field name="res_model">hms.diet.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hms_diet_type_search"/>
    </record>
    <menuitem id="menu_hms_diet_type" name="Jenis Diet"
              parent="custom_hms_base.menu_hms_config_master" action="action_hms_diet_type"
              sequence="62"/>
</odoo>
