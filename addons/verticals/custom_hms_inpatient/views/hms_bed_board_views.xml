<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The bed board is the kanban of hms.bed grouped by ward. Odoo's own
         kanban is good enough here and costs nothing to maintain; the Next.js
         board exists for the wall-mounted screens, not to replace this. -->
    <record id="view_hms_bed_kanban" model="ir.ui.view">
        <field name="name">hms.bed.kanban</field>
        <field name="model">hms.bed</field>
        <field name="arch" type="xml">
            <kanban default_group_by="ward_id" class="o_kanban_small_column" create="false">
                <field name="state"/>
                <field name="code"/>
                <field name="room_id"/>
                <field name="class_id"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong><field name="code"/></strong>
                                    <small class="text-muted d-block"><field name="room_id"/></small>
                                </div>
                                <span t-attf-class="badge #{
                                    record.state.raw_value == 'vacant' and 'text-bg-success' or
                                    record.state.raw_value == 'occupied' and 'text-bg-danger' or
                                    record.state.raw_value == 'cleaning' and 'text-bg-warning' or
                                    'text-bg-secondary'}">
                                    <field name="state"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="class_id"/>
                                <div t-if="record.state.raw_value == 'occupied'">
                                    <i class="fa fa-user"/> <field name="bed_type"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="action_hms_bed_board" model="ir.actions.act_window">
        <field name="name">Bed Board</field>
        <field name="res_model">hms.bed</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_g_ward': 1}</field>
    </record>
    <menuitem id="menu_hms_bed_board" name="Bed Board"
              parent="custom_hms_base.menu_hms_inpatient_root" action="action_hms_bed_board"
              sequence="5"/>
</odoo>
