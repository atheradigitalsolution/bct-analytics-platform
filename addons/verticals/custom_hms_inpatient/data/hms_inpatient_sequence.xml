<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_hms_admission" model="ir.sequence">
            <field name="name">Nomor Admisi</field>
            <field name="code">hms.admission</field>
            <field name="prefix">ADM-%(year)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="implementation">no_gap</field>
            <field name="use_date_range" eval="True"/>
        </record>

        <!-- The three charges every inpatient day produces. Room has no tariff
             set: it is resolved from the class actually being billed that day. -->
        <record id="rule_daily_room" model="hms.daily.charge.rule">
            <field name="name">Akomodasi Kamar</field>
            <field name="charge_type">room</field>
            <field name="sequence">10</field>
        </record>
        <record id="rule_daily_visit" model="hms.daily.charge.rule">
            <field name="name">Visite DPJP</field>
            <field name="charge_type">visit</field>
            <field name="requires_doctor_note" eval="True"/>
            <field name="sequence">20</field>
        </record>
        <record id="rule_daily_nursing" model="hms.daily.charge.rule">
            <field name="name">Asuhan Keperawatan</field>
            <field name="charge_type">nursing</field>
            <field name="sequence">30</field>
        </record>
    </data>
</odoo>
