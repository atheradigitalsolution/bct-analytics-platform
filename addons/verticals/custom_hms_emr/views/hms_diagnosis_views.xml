<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hms_diagnosis_list" model="ir.ui.view">
        <field name="name">hms.diagnosis.list</field>
        <field name="model">hms.diagnosis</field>
        <field name="arch" type="xml">
            <list string="Diagnosis" editable="bottom">
                <field name="icd10_id"/>
                <field name="rank"/>
                <field name="stage"/>
                <field name="practitioner_id"/>
                <field name="diagnosed_at"/>
                <field name="note"/>
            </list>
        </field>
    </record>
    <record id="action_hms_diagnosis" model="ir.actions.act_window">
        <field name="name">Diagnosis</field>
        <field name="res_model">hms.diagnosis</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_hms_procedure_list" model="ir.ui.view">
        <field name="name">hms.procedure.list</field>
        <field name="model">hms.procedure</field>
        <field name="arch" type="xml">
            <list string="Tindakan" editable="bottom">
                <field name="performed_at"/>
                <field name="name"/>
                <field name="icd9_id"/>
                <field name="tariff_id"/>
                <field name="practitioner_id"/>
                <field name="outcome"/>
                <field name="consent_id" optional="show"/>
            </list>
        </field>
    </record>
    <record id="action_hms_procedure" model="ir.actions.act_window">
        <field name="name">Tindakan</field>
        <field name="res_model">hms.procedure</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
