<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_hms_verbal_order" model="ir.sequence">
            <field name="name">Nomor Perintah Lisan</field>
            <field name="code">hms.verbal.order</field>
            <field name="prefix">VO-%(year)s%(month)s%(day)s-</field>
            <field name="padding">4</field>
            <field name="implementation">standard</field>
            <field name="use_date_range" eval="True"/>
        </record>
        <record id="seq_hms_delegation" model="ir.sequence">
            <field name="name">Nomor Pelimpahan Wewenang</field>
            <field name="code">hms.delegation</field>
            <field name="prefix">DLG-%(year)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="implementation">standard</field>
            <field name="use_date_range" eval="True"/>
        </record>
    </data>
</odoo>
