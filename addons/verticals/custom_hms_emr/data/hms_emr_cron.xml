<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Menandai, bukan memblokir. Lihat komentar pada
            models/hms_verbal_order.py: perintah lisan yang lewat tenggat tetap
            harus bisa ditandatangani belakangan.
        -->
        <record id="cron_hms_verbal_order_expire" model="ir.cron">
            <field name="name">SIMRS: tandai perintah lisan lewat batas tanda tangan</field>
            <field name="model_id" ref="model_hms_verbal_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_flag_expired()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_hms_delegation_expire" model="ir.cron">
            <field name="name">SIMRS: kedaluwarsakan pelimpahan wewenang</field>
            <field name="model_id" ref="model_hms_delegation"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
