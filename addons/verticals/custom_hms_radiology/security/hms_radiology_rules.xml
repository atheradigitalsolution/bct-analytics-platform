<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Pola yang sama persis dengan custom_hms_lab/security/hms_lab_rules.xml
            dan dengan F-EMR-07 di custom_hms_emr: keterlibatan dibaca sebagai
            DPJP kunjungan atau praktisi unit kunjungan, dan cakupannya hanya
            perm_write supaya hak baca yang sudah berjalan tidak ikut menyempit.
        -->
        <record id="rule_hms_rad_report_ack_involved" model="ir.rule">
            <field name="name">Ekspertise: klinisi hanya menulis pada pasien yang dirawatnya</field>
            <field name="model_id" ref="model_hms_rad_report"/>
            <field name="domain_force">['|',
                ('encounter_id.practitioner_id.user_id', '=', user.id),
                ('encounter_id.unit_id.practitioner_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('custom_hms_base.group_hms_emr_clinician'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_hms_rad_report_diagnostic_all" model="ir.rule">
            <field name="name">Ekspertise: petugas penunjang &amp; admin menulis semua</field>
            <field name="model_id" ref="model_hms_rad_report"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('custom_hms_base.group_hms_diagnostic_user')),
                                        (4, ref('custom_hms_base.group_hms_admin'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
