<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Lihat catatan desain di `_compute_ack_state`: cabang `overdue`
            bergantung pada waktu berjalan, sehingga computed-stored perlu
            penyapu berkala. Tanpa cron ini, temuan kritis yang tidak pernah
            diakui akan tetap terbaca `pending` selamanya.
        -->
        <record id="cron_hms_rad_ack_overdue" model="ir.cron">
            <field name="name">SIMRS: tandai temuan kritis radiologi yang terlambat diakui</field>
            <field name="model_id" ref="model_hms_rad_report"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_ack_state()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
