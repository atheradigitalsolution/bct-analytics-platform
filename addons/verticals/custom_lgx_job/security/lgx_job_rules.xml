<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Pemisahan per perusahaan dan per cabang berlaku pada DOKUMEN, bukan
            pada master. Dua aturan terpisah dengan sengaja: yang pertama adalah
            batas hukum (perusahaan), yang kedua batas organisasi (cabang), dan
            melonggarkan yang kedua tidak boleh ikut melonggarkan yang pertama.
        -->
        <record id="rule_lgx_job_company" model="ir.rule">
            <field name="name">Job: per perusahaan</field>
            <field name="model_id" ref="model_lgx_job"/>
            <field name="domain_force">[('company_id','in',company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_lgx_job_operating_unit" model="ir.rule">
            <field name="name">Job: per cabang yang diizinkan</field>
            <field name="model_id" ref="model_lgx_job"/>
            <field name="domain_force">['|',('operating_unit_id','=',False),('operating_unit_id','in',user.allowed_operating_unit_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('custom_lgx_base.group_lgx_staff'))]"/>
        </record>
        <record id="rule_lgx_job_charge_company" model="ir.rule">
            <field name="name">Baris charge: per perusahaan</field>
            <field name="model_id" ref="model_lgx_job_charge"/>
            <field name="domain_force">[('company_id','in',company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_lgx_milestone_company" model="ir.rule">
            <field name="name">Milestone: per perusahaan</field>
            <field name="model_id" ref="model_lgx_milestone"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
