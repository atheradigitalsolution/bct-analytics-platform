<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_hms_nursing_overdue" model="ir.cron">
            <field name="name">SIMRS: tandai tugas keperawatan terlambat</field>
            <field name="model_id" ref="model_hms_nursing_task"/>
            <field name="state">code</field>
            <field name="code">model._cron_mark_overdue()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_hms_nursing_vitals" model="ir.cron">
            <field name="name">SIMRS: jadwalkan pengukuran TTV berikutnya</field>
            <field name="model_id" ref="model_hms_nursing_task"/>
            <field name="state">code</field>
            <field name="code">model._cron_schedule_vitals()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
