<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_hms_medicine_label" model="report.paperformat">
        <field name="name">SIMRS Etiket Obat (70 x 40 mm)</field>
        <field name="format">custom</field>
        <field name="page_width">70</field>
        <field name="page_height">40</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">2</field>
        <field name="margin_bottom">2</field>
        <field name="margin_left">2</field>
        <field name="margin_right">2</field>
        <field name="dpi">300</field>
    </record>
    <record id="report_hms_medicine_label" model="ir.actions.report">
        <field name="name">Etiket Obat</field>
        <field name="model">hms.prescription</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_hms_pharmacy.report_medicine_label_document</field>
        <field name="report_file">custom_hms_pharmacy.report_medicine_label_document</field>
        <field name="paperformat_id" ref="paperformat_hms_medicine_label"/>
        <field name="binding_model_id" ref="model_hms_prescription"/>
        <field name="binding_type">report</field>
    </record>
    <record id="report_hms_prescription" model="ir.actions.report">
        <field name="name">Lembar Resep</field>
        <field name="model">hms.prescription</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_hms_pharmacy.report_prescription_document</field>
        <field name="report_file">custom_hms_pharmacy.report_prescription_document</field>
        <field name="binding_model_id" ref="model_hms_prescription"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
