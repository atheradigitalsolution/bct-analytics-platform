<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hms_medicine_list" model="ir.ui.view">
        <field name="name">hms.medicine.list</field>
        <field name="model">hms.medicine</field>
        <field name="arch" type="xml">
            <list string="Obat &amp; BHP" decoration-danger="is_high_alert"
                  decoration-warning="is_lasa">
                <field name="generic_name"/>
                <field name="brand_name"/>
                <field name="strength_display"/>
                <field name="dosage_form_id"/>
                <field name="item_type"/>
                <field name="drug_class_id" optional="hide"/>
                <field name="is_high_alert"/>
                <field name="is_lasa" optional="show"/>
                <field name="is_narcotic" optional="show"/>
                <field name="is_formularium_hospital" optional="show"/>
                <field name="bpjs_covered" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_hms_medicine_form" model="ir.ui.view">
        <field name="name">hms.medicine.form</field>
        <field name="model">hms.medicine</field>
        <field name="arch" type="xml">
            <form string="Obat">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="generic_name" placeholder="Nama generik"/></h1>
                        <h3><field name="brand_name" placeholder="Nama dagang"/></h3>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not is_high_alert">
                        OBAT HIGH ALERT — penyerahan dan pemberian wajib double-check petugas kedua.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not is_lasa">
                        LASA (<field name="lasa_group" readonly="1" class="oe_inline"/>) —
                        perhatikan kemiripan nama dan rupa.
                    </div>
                    <group>
                        <group string="Identitas">
                            <field name="product_tmpl_id"/>
                            <field name="item_type"/>
                            <field name="dosage_form_id"/>
                            <field name="strength_display"/>
                            <field name="route_ids" widget="many2many_tags"/>
                            <field name="unit_dispense_id"/>
                            <field name="pack_size"/>
                            <field name="manufacturer_id"/>
                        </group>
                        <group string="Kode &amp; Regulasi">
                            <field name="kfa_code"/>
                            <field name="bpom_reg_no"/>
                            <field name="atc_code"/>
                            <field name="drug_class_id"/>
                            <field name="is_generic"/>
                            <field name="is_formularium_national"/>
                            <field name="is_formularium_hospital"/>
                            <field name="requires_prescription"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Zat Aktif">
                            <field name="ingredient_ids">
                                <list editable="bottom">
                                    <field name="ingredient_id"/>
                                    <field name="strength"/>
                                    <field name="strength_unit"/>
                                </list>
                            </field>
                        </page>
                        <page string="Keamanan">
                            <group>
                                <group string="Penanda">
                                    <field name="is_high_alert"/>
                                    <field name="is_lasa"/>
                                    <field name="lasa_group" invisible="not is_lasa"/>
                                    <field name="display_tallman" invisible="not is_lasa"/>
                                    <field name="is_narcotic"/>
                                    <field name="is_psychotropic"/>
                                    <field name="is_precursor"/>
                                </group>
                                <group string="Antibiotik &amp; Penyimpanan">
                                    <field name="is_antibiotic"/>
                                    <field name="antibiotic_category" invisible="not is_antibiotic"/>
                                    <field name="is_cold_chain"/>
                                    <field name="storage_temp_min" invisible="not is_cold_chain"/>
                                    <field name="storage_temp_max" invisible="not is_cold_chain"/>
                                    <field name="shelf_location"/>
                                </group>
                            </group>
                            <group string="Peringatan Klinis">
                                <field name="pregnancy_category"/>
                                <field name="max_dose_daily"/>
                                <field name="max_dose_unit"/>
                                <field name="renal_adjust"/>
                                <field name="hepatic_adjust"/>
                            </group>
                            <field name="contraindication_note"/>
                        </page>
                        <page string="Default Resep">
                            <group>
                                <group>
                                    <field name="default_sig"/>
                                    <field name="default_dose"/>
                                    <field name="default_frequency_id"/>
                                    <field name="default_duration_days"/>
                                    <field name="is_prn_allowed"/>
                                </group>
                                <group>
                                    <field name="price_hna"/>
                                    <field name="price_het"/>
                                    <field name="bpjs_covered"/>
                                    <field name="bpjs_restriction"/>
                                    <field name="label_note"/>
                                    <field name="state"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_hms_medicine_search" model="ir.ui.view">
        <field name="name">hms.medicine.search</field>
        <field name="model">hms.medicine</field>
        <field name="arch" type="xml">
            <search>
                <field name="generic_name"/>
                <field name="brand_name"/>
                <field name="drug_class_id"/>
                <filter name="f_high_alert" string="High Alert" domain="[('is_high_alert', '=', True)]"/>
                <filter name="f_narcotic" string="Narkotika/Psikotropika"
                        domain="['|', ('is_narcotic', '=', True), ('is_psychotropic', '=', True)]"/>
                <filter name="f_fornas" string="Fornas" domain="[('is_formularium_national', '=', True)]"/>
                <separator/>
                <filter name="g_form" string="Bentuk Sediaan" context="{'group_by': 'dosage_form_id'}"/>
                <filter name="g_class" string="Kelas Terapi" context="{'group_by': 'drug_class_id'}"/>
            </search>
        </field>
    </record>
    <record id="action_hms_medicine" model="ir.actions.act_window">
        <field name="name">Obat &amp; BHP</field>
        <field name="res_model">hms.medicine</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hms_medicine_search"/>
    </record>
    <menuitem id="menu_hms_medicine" name="Obat &amp; BHP"
              parent="custom_hms_base.menu_hms_pharmacy_root" action="action_hms_medicine"
              sequence="30"/>
</odoo>
