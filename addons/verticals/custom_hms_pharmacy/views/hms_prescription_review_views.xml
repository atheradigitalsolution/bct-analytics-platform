<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Telaah tiga aspek disisipkan ke form resep yang sudah ada, bukan
        menggantinya: alur verifikasi/penyiapan/penyerahan tetap persis seperti
        sebelumnya, dan tombol "Catat Telaah" berdiri sendiri di sebelah
        "Verifikasi" — dua tindakan, dua catatan, dua angka kepatuhan.
    -->
    <record id="view_hms_prescription_form_review" model="ir.ui.view">
        <field name="name">hms.prescription.form.telaah</field>
        <field name="model">hms.prescription</field>
        <field name="inherit_id" ref="custom_hms_pharmacy.view_hms_prescription_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reject_reason']" position="before">
                <notebook>
                    <page string="Telaah Resep (3 Aspek)" name="telaah">
                        <div class="alert alert-warning" role="alert"
                             invisible="not has_blocking_intervention">
                            Obat sedang ditahan oleh intervensi apoteker yang belum
                            dijawab penulis resep. Penyerahan akan ditolak sampai
                            intervensi diselesaikan atau ditarik beralasan.
                        </div>
                        <group>
                            <group>
                                <field name="review_state" readonly="1"/>
                                <field name="reviewed_by_id" readonly="1"/>
                                <field name="reviewed_at" readonly="1"/>
                            </group>
                            <group>
                                <field name="open_intervention_count" readonly="1"/>
                                <field name="has_blocking_intervention" readonly="1"/>
                            </group>
                        </group>
                        <group string="Administratif">
                            <field name="review_admin_result"/>
                            <field name="review_admin_note"
                                   invisible="review_admin_result != 'issue'"/>
                        </group>
                        <group string="Farmasetik">
                            <field name="review_pharmaceutic_result"/>
                            <field name="review_pharmaceutic_note"
                                   invisible="review_pharmaceutic_result != 'issue'"/>
                        </group>
                        <group string="Klinis">
                            <field name="review_clinical_result"/>
                            <field name="review_clinical_note"
                                   invisible="review_clinical_result != 'issue'"/>
                        </group>
                    </page>
                    <page string="Intervensi Apoteker" name="intervensi">
                        <field name="intervention_ids">
                            <list decoration-danger="state == 'open' and action_taken == 'hold'"
                                  decoration-muted="state != 'open'">
                                <field name="raised_at"/>
                                <field name="line_id" optional="show"/>
                                <field name="issue_type"/>
                                <field name="finding"/>
                                <field name="action_taken"/>
                                <field name="pharmacist_id" optional="hide"/>
                                <field name="prescriber_response"/>
                                <field name="outcome"/>
                                <field name="state" widget="badge"/>
                                <button name="action_resolve" type="object" icon="fa-check"
                                        string="Selesaikan" invisible="state != 'open'"/>
                            </list>
                            <form string="Intervensi Apoteker">
                                <group>
                                    <group>
                                        <field name="line_id"/>
                                        <field name="issue_type"/>
                                        <field name="action_taken"/>
                                        <field name="pharmacist_id"/>
                                        <field name="raised_at"/>
                                    </group>
                                    <group>
                                        <field name="state" readonly="1"/>
                                        <field name="outcome"/>
                                        <field name="resolved_at" readonly="1"/>
                                        <field name="withdraw_reason"
                                               invisible="state == 'resolved'"/>
                                    </group>
                                </group>
                                <separator string="Uraian Temuan"/>
                                <field name="finding"/>
                                <separator string="Jawaban Penulis Resep"/>
                                <field name="prescriber_response"/>
                            </form>
                        </field>
                    </page>
                </notebook>
            </xpath>
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_record_review" type="object" string="Catat Telaah"
                        invisible="state in ('dispensed', 'rejected', 'cancelled')"/>
            </xpath>
        </field>
    </record>

    <record id="view_hms_prescription_list_review" model="ir.ui.view">
        <field name="name">hms.prescription.list.telaah</field>
        <field name="model">hms.prescription</field>
        <field name="inherit_id" ref="custom_hms_pharmacy.view_hms_prescription_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="review_state" widget="badge" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
