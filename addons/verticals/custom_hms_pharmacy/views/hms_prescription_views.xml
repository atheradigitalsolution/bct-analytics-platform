<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hms_prescription_list" model="ir.ui.view">
        <field name="name">hms.prescription.list</field>
        <field name="model">hms.prescription</field>
        <field name="arch" type="xml">
            <list string="Resep" decoration-danger="is_cito or has_high_alert"
                  decoration-muted="state in ('cancelled', 'rejected')"
                  decoration-success="state == 'dispensed'">
                <field name="name"/>
                <field name="prescribed_at"/>
                <field name="patient_id"/>
                <field name="depot_id"/>
                <field name="practitioner_id"/>
                <field name="type"/>
                <field name="is_cito" optional="show"/>
                <field name="has_high_alert" optional="show"/>
                <field name="waiting_minutes" string="Tunggu (mnt)"/>
                <field name="state" widget="badge"/>
                <button name="action_verify" type="object" string="Verifikasi" icon="fa-check-circle"
                        invisible="state != 'submitted'"/>
                <button name="action_prepare" type="object" string="Siapkan" icon="fa-flask"
                        invisible="state != 'verified'"/>
                <button name="action_ready" type="object" string="Siap" icon="fa-bell"
                        invisible="state != 'preparing'"/>
                <button name="action_dispense" type="object" string="Serahkan" icon="fa-hand-o-right"
                        invisible="state not in ('verified', 'preparing', 'ready')"/>
            </list>
        </field>
    </record>

    <record id="view_hms_prescription_form" model="ir.ui.view">
        <field name="name">hms.prescription.form</field>
        <field name="model">hms.prescription</field>
        <field name="arch" type="xml">
            <form string="Resep">
                <header>
                    <button name="action_submit" type="object" string="Kirim ke Apotek"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_verify" type="object" string="Verifikasi Apoteker"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="custom_hms_base.group_hms_pharmacist"/>
                    <button name="action_prepare" type="object" string="Mulai Siapkan"
                            invisible="state != 'verified'"/>
                    <button name="action_ready" type="object" string="Tandai Siap"
                            invisible="state != 'preparing'"/>
                    <button name="action_dispense" type="object" string="Serahkan ke Pasien"
                            class="btn-primary"
                            invisible="state not in ('verified', 'preparing', 'ready')"/>
                    <button name="action_reject" type="object" string="Tolak Resep"
                            invisible="state not in ('submitted', 'verified')"/>
                    <button name="action_cancel" type="object" string="Batalkan"
                            invisible="state in ('dispensed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,verified,preparing,ready,dispensed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <div class="alert alert-danger" role="alert" invisible="not allergy_warning">
                        <strong>PERINGATAN ALERGI</strong>
                        <field name="allergy_warning" readonly="1" nolabel="1"/>
                        <div class="mt-2">
                            Apoteker dapat tetap menyerahkan bila secara klinis dinilai aman —
                            keputusan itu tercatat atas nama pengguna yang menyerahkan.
                        </div>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not has_high_alert">
                        Resep memuat obat <strong>high alert</strong>. Saksi double-check wajib
                        diisi sebelum penyerahan.
                    </div>
                    <group>
                        <group>
                            <field name="encounter_id"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="practitioner_id"/>
                            <field name="type"/>
                            <field name="is_cito"/>
                        </group>
                        <group>
                            <field name="depot_id"/>
                            <field name="prescribed_at"/>
                            <field name="order_id" readonly="1"/>
                            <field name="picking_id" readonly="1"/>
                            <field name="has_narcotic" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom" decoration-danger="medicine_id.is_high_alert">
                            <field name="sequence" widget="handle"/>
                            <field name="medicine_id"/>
                            <field name="dose"/>
                            <field name="dose_unit"/>
                            <field name="frequency_id"/>
                            <field name="route_id"/>
                            <field name="duration_days"/>
                            <field name="qty_prescribed"/>
                            <field name="qty_dispense"/>
                            <field name="sig"/>
                            <field name="is_prn" optional="show"/>
                            <field name="is_compound" optional="hide"/>
                            <field name="state" readonly="1" widget="badge"/>
                        </list>
                    </field>
                    <group string="Penyerahan" invisible="state not in ('ready', 'dispensed')">
                        <group>
                            <field name="witness_id"
                                   required="has_high_alert and state == 'ready'"/>
                            <field name="received_by"/>
                        </group>
                        <group>
                            <field name="verified_by_id" readonly="1"/>
                            <field name="dispensed_by_id" readonly="1"/>
                            <field name="dispensed_at" readonly="1"/>
                        </group>
                    </group>
                    <field name="reject_reason" invisible="state != 'rejected'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hms_prescription_search" model="ir.ui.view">
        <field name="name">hms.prescription.search</field>
        <field name="model">hms.prescription</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="depot_id"/>
                <field name="practitioner_id"/>
                <filter name="f_queue" string="Antrian Apotek"
                        domain="[('state', 'in', ('submitted', 'verified', 'preparing', 'ready'))]"/>
                <filter name="f_cito" string="CITO" domain="[('is_cito', '=', True)]"/>
                <filter name="f_high_alert" string="High Alert" domain="[('has_high_alert', '=', True)]"/>
                <separator/>
                <filter name="g_depot" string="Depo" context="{'group_by': 'depot_id'}"/>
                <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_hms_prescription" model="ir.actions.act_window">
        <field name="name">Resep</field>
        <field name="res_model">hms.prescription</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hms_prescription_search"/>
    </record>
    <record id="action_hms_pharmacy_queue" model="ir.actions.act_window">
        <field name="name">Antrian Apotek</field>
        <field name="res_model">hms.prescription</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hms_prescription_search"/>
        <field name="context">{'search_default_f_queue': 1, 'search_default_g_depot': 1}</field>
    </record>
    <menuitem id="menu_hms_pharmacy_queue" name="Antrian Apotek"
              parent="custom_hms_base.menu_hms_pharmacy_root" action="action_hms_pharmacy_queue"
              sequence="10"/>
    <menuitem id="menu_hms_prescription" name="Semua Resep"
              parent="custom_hms_base.menu_hms_pharmacy_root" action="action_hms_prescription"
              sequence="20"/>
</odoo>
