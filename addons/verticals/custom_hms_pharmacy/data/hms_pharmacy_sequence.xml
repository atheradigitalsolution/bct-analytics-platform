<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_hms_prescription" model="ir.sequence">
            <field name="name">Nomor Resep</field>
            <field name="code">hms.prescription</field>
            <field name="prefix">RX-%(year)s%(month)s%(day)s-</field>
            <field name="padding">4</field>
            <field name="implementation">standard</field>
            <field name="use_date_range" eval="True"/>
        </record>
        <record id="seq_hms_medication_reconciliation" model="ir.sequence">
            <field name="name">Nomor Rekonsiliasi Obat</field>
            <field name="code">hms.medication.reconciliation</field>
            <field name="prefix">REK-%(year)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="implementation">standard</field>
            <field name="use_date_range" eval="True"/>
        </record>
    </data>
</odoo>
