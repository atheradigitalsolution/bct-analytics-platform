<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_lgx_duty_log_company" model="ir.rule">
            <field name="name">Log jam kerja: per perusahaan</field>
            <field name="model_id" ref="model_lgx_driver_duty_log"/>
            <field name="domain_force">[('company_id','in',company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_lgx_duty_log_own_driver" model="ir.rule">
            <field name="name">Log jam kerja: pengemudi hanya melihat miliknya</field>
            <field name="model_id" ref="model_lgx_driver_duty_log"/>
            <field name="domain_force">[('driver_id.user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('custom_lgx_base.group_lgx_driver'))]"/>
        </record>
    </data>
</odoo>
