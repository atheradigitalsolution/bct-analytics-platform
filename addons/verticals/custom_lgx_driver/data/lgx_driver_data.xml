<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_lgx_duty_log" model="ir.cron">
            <field name="name">LGX: bangun log jam kerja pengemudi dari trip kemarin</field>
            <field name="model_id" ref="model_lgx_driver_duty_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_build_duty_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
