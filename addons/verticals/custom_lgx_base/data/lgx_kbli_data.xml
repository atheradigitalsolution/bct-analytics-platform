        <!--
            Pemetaan antar versi. Dijalankan lewat <function> supaya ia
            idempoten dan berjalan ulang setiap update — pemetaan yang lahir di
            noupdate="1" tidak akan pernah diperbaiki ketika konversinya
            akhirnya terkonfirmasi.
        -->
    </data>
    <data>
        <function model="lgx.kbli" name="_lgx_seed_version_mapping"/>
    </data>
</odoo>
