            <field name="section">H</field>
            <field name="risk_level">menengah_tinggi</field>
            <field name="permit_form">NIB + Sertifikat Standar</field>
            <field name="requirement_note">Bukti lulus uji berkala (KIR); denah dan foto pool; fasilitas bongkar muat; GPS terpasang di kendaraan.</field>
            <field name="is_verified">1</field>
            <field name="source_note">oss.go.id/kbli/detail</field>
        </record>
        <record id="kbli_2025_49231" model="lgx.kbli">
