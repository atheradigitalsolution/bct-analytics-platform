            <field name="is_verified">1</field>
            <field name="source_note">oss.go.id/kbli/detail</field>
        </record>

        <!-- Pergudangan — ⚠ KONVERSI BELUM TERKONFIRMASI (butir A9) -->
        <record id="kbli_2020_52101" model="lgx.kbli">
            <field name="version">2020</field><field name="code">52101</field>
            <field name="name">Pergudangan dan Penyimpanan</field>
            <field name="section">H</field>
            <field name="is_verified">1</field>
        </record>
        <record id="kbli_2025_52109" model="lgx.kbli">
