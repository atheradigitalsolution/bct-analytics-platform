<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Kode KBLI yang relevan untuk logistik, KEDUA versi.
            
            Ini BUKAN KBLI lengkap (~1.700 kode per versi). Yang lengkap dimuat
            lewat `lgx.kbli.lgx_import_csv` dari ekspor resmi BPS/OSS — butir A9
            dan A25 di Lampiran A. Daftar di sini sengaja kecil dan jelas-jelas
            kecil, supaya tidak ada yang mengira ia lengkap.

            `is_verified` menandai mana yang sudah dikonfirmasi ke sumber primer.
            Yang False TERLIHAT begitu di layar — bukan disembunyikan di komentar
            kode yang tidak dibaca siapa pun.
        -->

        <!-- Jasa Pengurusan Transportasi -->
        <record id="kbli_2020_52291" model="lgx.kbli">
            <field name="version">2020</field><field name="code">52291</field>
            <field name="name">Jasa Pengurusan Transportasi (JPT)</field>
            <field name="section">H</field>
            <field name="is_verified">1</field>
            <field name="source_note">oss.go.id/kbli/detail</field>
        </record>
        <record id="kbli_2025_52311" model="lgx.kbli">
            <field name="version">2025</field><field name="code">52311</field>
            <field name="name">Jasa Pengurusan Transportasi (JPT)</field>
            <field name="section">H</field>
            <field name="is_verified">1</field>
            <field name="source_note">oss.go.id/kbli/detail</field>
        </record>

