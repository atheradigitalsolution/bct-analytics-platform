        <!-- Jam kerja pengemudi. A12c TERTUTUP (diperiksa 2026-09-20).

             UU 22/2009 Pasal 90: waktu kerja pengemudi paling lama 8 jam
             sehari; setelah mengemudi 4 jam berturut-turut wajib istirahat
             sekurang-kurangnya setengah jam; dalam hal tertentu paling lama
             12 jam sehari termasuk 1 jam istirahat. Keempat angka di bawah
             cocok dengan bunyi pasal itu - 240 / 30 / 480 / 720 menit.

             Perhatikan 720 sudah TERMASUK 1 jam istirahat, jadi ia batas
             rentang tugas, bukan 12 jam mengemudi murni.

             Pasal 92: perusahaan angkutan umum yang tidak mematuhi Pasal 90
             dikenai sanksi administratif - peringatan tertulis, denda
             administratif, pembekuan izin, sampai pencabutan izin. Sanksinya
             jatuh ke PERUSAHAAN, bukan ke pengemudi. Itulah alasan struktural
             lgx.driver.duty.log disimpan dan dipertahankan: ia bukan sekadar
             alat keselamatan internal, ia bukti kepatuhan milik perusahaan
             saat ditanya. -->
        <record id="param_duty_max_continuous_driving" model="ir.config_parameter">
            <field name="key">lgx.duty_max_continuous_driving_minutes</field>
            <field name="value">240</field>
        </record>
        <record id="param_duty_required_rest" model="ir.config_parameter">
            <field name="key">lgx.duty_required_rest_minutes</field>
            <field name="value">30</field>
        </record>
        <record id="param_duty_max_daily_working" model="ir.config_parameter">
            <field name="key">lgx.duty_max_daily_working_minutes</field>
            <field name="value">480</field>
        </record>
        <record id="param_duty_absolute_max_working" model="ir.config_parameter">
            <field name="key">lgx.duty_absolute_max_working_minutes</field>
            <field name="value">720</field>
        </record>

        <!-- Pajak. Tarif efektif, bukan konstanta di kode (§11, LGX-F02).

             A1 dan A2 DITUTUP (diperiksa 2026-09-20), dan hasilnya melegakan
             dengan cara yang tidak terduga: angkanya tidak berubah, tetapi
             asal-usulnya berubah seluruhnya.

             PMK 71/2022 menetapkan JPT yang tagihannya memuat biaya transportasi
             sebagai JKP Tertentu, dulu 10% x 11% = 1,1%. PMK 11/2025 mengubah
             rumusnya mengikuti kenaikan tarif umum ke 12%, menjadi
             10% x 11/12 x 12% — yang tetap 1,1%. PMK 53/2025 (berlaku 1 Agustus
             2025) mengubah PMK 11/2025 lagi dan MENEGASKAN pengali 11/12 itu.

             Jadi rantainya PMK 71/2022 -> PMK 11/2025 -> PMK 53/2025, dan 1,1
             di bawah ini bertahan melewati ketiganya. Siapa pun yang mengutip
             "PMK 71/2022" sendirian untuk membenarkan angka ini mengutip aturan
             yang sudah dua kali diubah.

             CATATAN JUJUR tentang kedua parameter ini: tidak ada kode yang
             membaca lgx.vat_besaran_tertentu_rate. Nilai PPN sesungguhnya
             datang dari record account.tax yang menempel di sale_tax_ids kode
             biaya. Parameter ini rujukan dan jejak keputusan, bukan sumber
             perhitungan - dan menyebutnya sumber perhitungan akan membuat orang
             mengubahnya lalu heran mengapa faktur tidak bergerak.

             lgx.vat_default_without_freight SEBALIKNYA memang dibaca, di
             custom_lgx_tax_id/models/account_move.py, dan ia yang menentukan
             cabang saat tagihan JPT tidak memuat freight charge (butir A3). -->
        <record id="param_vat_besaran_tertentu_rate" model="ir.config_parameter">
            <field name="key">lgx.vat_besaran_tertentu_rate</field>
            <field name="value">1.1</field>
        </record>
        <record id="param_vat_default_without_freight" model="ir.config_parameter">
            <field name="key">lgx.vat_default_without_freight</field>
            <field name="value">standard</field>
        </record>
        <record id="param_pph23_rate" model="ir.config_parameter">
            <field name="key">lgx.pph23_rate</field>
            <field name="value">2.0</field>
        </record>
        <record id="param_pph23_rate_no_npwp" model="ir.config_parameter">
            <field name="key">lgx.pph23_rate_no_npwp</field>
            <field name="value">4.0</field>
        </record>
        <record id="param_pph15_sea_rate" model="ir.config_parameter">
            <field name="key">lgx.pph15_sea_rate</field>
            <field name="value">1.2</field>
        </record>
        <record id="param_pph15_air_rate" model="ir.config_parameter">
            <field name="key">lgx.pph15_air_rate</field>
            <field name="value">1.8</field>
        </record>
        <record id="param_pph15_foreign_rate" model="ir.config_parameter">
            <field name="key">lgx.pph15_foreign_rate</field>
            <field name="value">2.64</field>
        </record>
        <!-- A4 TERTUTUP: sumber DJP (SE-35/PJ.4/1996) menyatakan 1,8%
             penerbangan dalam negeri TIDAK final dan dapat dikreditkan.
             Sumber sekunder yang menyebut final keliru. -->
        <record id="param_pph15_air_is_final" model="ir.config_parameter">
            <field name="key">lgx.pph15_air_is_final</field>
            <field name="value">0</field>
        </record>
        <record id="param_stamp_duty_amount" model="ir.config_parameter">
            <field name="key">lgx.stamp_duty_amount</field>
            <field name="value">10000</field>
        </record>
        <record id="param_stamp_duty_receipt_threshold" model="ir.config_parameter">
            <field name="key">lgx.stamp_duty_receipt_threshold</field>
            <field name="value">5000000</field>
        </record>
        <!-- A10 DITUTUP (diperiksa 2026-09-20). Angkanya benar, tetapi ia
             BUKAN SATU-SATUNYA BATAS, dan parameter tunggal ini tidak dapat
             menyatakan sisanya.

             Coretax menerima 1.000 faktur pajak per berkas XML — naik dari 100
             sebelumnya. Jadi 1000 di bawah tepat untuk batas unggah.

             Dua batas lain yang tidak terwakili di sini:

             * UKURAN BERKAS maksimum 100 MB. Seribu faktur dengan banyak baris
               masing-masing dapat melewatinya jauh sebelum mencapai hitungan
               seribu. Pemecah batch yang hanya menghitung dokumen akan
               menghasilkan berkas yang ditolak tanpa satu pun angka di sistem
               kita terlihat salah.
             * DJP MENYARANKAN penandatanganan bertahap 500 lembar per unggah,
               meski 1.000 dapat diunggah. Unggah dan tanda tangan adalah dua
               operasi dengan batas praktis yang berbeda.

             Untuk SPT Tahunan PPh Badan batasnya lain lagi: mulai dari 50.000
             baris lalu dinaikkan bertahap. Itu jenis dokumen berbeda dan tidak
             boleh memakai parameter yang sama.

             CATATAN: parameter ini belum dibaca kode mana pun (lihat audit di
             kepala berkas). Saat pemecah batch benar-benar dibangun, ia harus
             memeriksa UKURAN juga, bukan hanya jumlah — dan 500 versus 1.000
             harus menjadi dua nilai, bukan satu. -->
        <record id="param_coretax_xml_batch_size" model="ir.config_parameter">
            <field name="key">lgx.coretax_xml_batch_size</field>
            <field name="value">1000</field>
        </record>
        <record id="param_coretax_xml_max_bytes" model="ir.config_parameter">
            <field name="key">lgx.coretax_xml_max_bytes</field>
            <field name="value">104857600</field>
        </record>
        <record id="param_coretax_sign_batch_size" model="ir.config_parameter">
            <field name="key">lgx.coretax_sign_batch_size</field>
            <field name="value">500</field>
        </record>

