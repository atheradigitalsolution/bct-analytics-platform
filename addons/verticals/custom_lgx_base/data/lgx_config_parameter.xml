        <!-- A5 TERTUTUP (diperiksa 2026-09-20), dengan satu kejutan.

             Permenhub PM 19/2021 TIDAK memberi satu angka. Masa berlakunya
             bertingkat: uji berkala pendaftaran berlaku 1 TAHUN sejak STNK
             terbit, lalu uji berkala pertama dan seluruh perpanjangan
             berikutnya berlaku 6 BULAN. Jadi 6 adalah nilai kondisi tunak,
             benar untuk hampir semua kendaraan yang sudah beroperasi, dan
             SALAH untuk kendaraan yang baru keluar dealer.

             Parameter ini ada karena spesifikasi §10 meminta masa berlaku
             disimpan sebagai parameter, bukan konstanta. TETAPI: tidak ada
             kode yang membacanya, dan itu disengaja. fleet.vehicle menyimpan
             lgx_kir_expiry_date apa adanya, disalin dari kartu lulus uji -
             kartunya membawa tanggalnya sendiri, jadi menurunkan tanggal dari
             masa berlaku hanya menambah cara untuk salah.

             Kalau suatu saat ada yang ingin menurunkan tanggal dari angka ini,
             bacalah paragraf pertama dulu: satu skalar tidak cukup, dan
             kendaraan barulah yang akan salah dihitung. -->
        <record id="param_kir_validity_months" model="ir.config_parameter">
            <field name="key">lgx.kir_validity_months</field>
            <field name="value">6</field>
        </record>
        <!-- Batas penerbitan kunci perangkat: DUA dimensi, bukan satu.
             Berapa banyak yang hidup sekaligus adalah KEADAAN; berapa cepat
             diterbitkan adalah LAJU. Batas pertama saja melewatkan pencetakan
             cepat yang diselingi pencabutan; batas kedua saja melewatkan
             penumpukan lambat berbulan-bulan. -->
        <record id="param_device_max_active" model="ir.config_parameter">
            <field name="key">lgx.device_max_active</field>
            <field name="value">5</field>
        </record>
        <record id="param_device_issue_window_hours" model="ir.config_parameter">
            <field name="key">lgx.device_issue_window_hours</field>
            <field name="value">24</field>
        </record>
        <record id="param_device_issue_max_per_window" model="ir.config_parameter">
            <field name="key">lgx.device_issue_max_per_window</field>
            <field name="value">10</field>
        </record>
        <record id="param_occupancy_retention_months" model="ir.config_parameter">
            <field name="key">lgx.occupancy_retention_months</field>
            <field name="value">13</field>
        </record>
    </data>
