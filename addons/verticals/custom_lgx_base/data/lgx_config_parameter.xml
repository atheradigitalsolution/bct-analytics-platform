        <record id="param_air_weight_rounding" model="ir.config_parameter">
            <field name="key">lgx.air_weight_rounding_kg</field>
            <field name="value">0.5</field>
        </record>
        <record id="param_doc_expiry_warning_days" model="ir.config_parameter">
