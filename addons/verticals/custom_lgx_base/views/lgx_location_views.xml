<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lgx_location_list" model="ir.ui.view">
        <field name="name">lgx.location.list</field>
        <field name="model">lgx.location</field>
        <field name="arch" type="xml">
            <list string="Simpul Jaringan">
                <field name="code"/>
                <field name="name"/>
                <field name="location_type"/>
                <field name="country_id"/>
                <field name="city"/>
                <field name="customs_office_id" optional="show"/>
                <field name="is_domestic" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_lgx_location_form" model="ir.ui.view">
        <field name="name">lgx.location.form</field>
        <field name="model">lgx.location</field>
        <field name="arch" type="xml">
            <form string="Simpul Jaringan">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Tanjung Priok, Jakarta"/></h1>
                    </div>
                    <group>
                        <group string="Identitas">
                            <field name="code" placeholder="IDJKT"/>
                            <field name="location_type"/>
                            <field name="partner_id"/>
                            <field name="customs_office_id"/>
                        </group>
                        <group string="Letak">
                            <field name="country_id"/>
                            <field name="state_id"/>
                            <field name="city"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="is_domestic"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_lgx_location_search" model="ir.ui.view">
        <field name="name">lgx.location.search</field>
        <field name="model">lgx.location</field>
        <field name="arch" type="xml">
            <search string="Simpul">
                <field name="code"/>
                <field name="name"/>
                <field name="country_id"/>
                <filter name="f_seaport" string="Pelabuhan" domain="[('location_type','=','seaport')]"/>
                <filter name="f_airport" string="Bandara" domain="[('location_type','=','airport')]"/>
                <filter name="f_domestic" string="Dalam Negeri" domain="[('is_domestic','=',True)]"/>
                <separator/>
                    <filter name="g_type" string="Jenis" context="{'group_by':'location_type'}"/>
                    <filter name="g_country" string="Negara" context="{'group_by':'country_id'}"/>
            </search>
        </field>
    </record>
    <record id="action_lgx_location" model="ir.actions.act_window">
        <field name="name">Simpul Jaringan</field>
        <field name="res_model">lgx.location</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_lgx_customs_office_list" model="ir.ui.view">
        <field name="name">lgx.customs.office.list</field>
        <field name="model">lgx.customs.office</field>
        <field name="arch" type="xml">
            <list string="Kantor Pabean" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="office_type"/>
                <field name="city"/>
                <field name="ceisa_mandatory"/>
            </list>
        </field>
    </record>
    <record id="action_lgx_customs_office" model="ir.actions.act_window">
        <field name="name">Kantor Pabean</field>
        <field name="res_model">lgx.customs.office</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
