<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lgx_kbli_list" model="ir.ui.view">
        <field name="name">lgx.kbli.list</field>
        <field name="model">lgx.kbli</field>
        <field name="arch" type="xml">
            <list string="KBLI" decoration-warning="not is_verified">
                <field name="version"/>
                <field name="code"/>
                <field name="name"/>
                <field name="section" optional="show"/>
                <field name="risk_level"/>
                <field name="permit_form" optional="show"/>
                <field name="counterpart_ids" widget="many2many_tags"/>
                <field name="is_verified"/>
                <field name="source_note" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_lgx_kbli_form" model="ir.ui.view">
        <field name="name">lgx.kbli.form</field>
        <field name="model">lgx.kbli</field>
        <field name="arch" type="xml">
            <form string="KBLI">
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="is_verified">
                        Kode atau pemetaan ini berasal dari riset sekunder dan
                        <b>belum dikonfirmasi ke OSS/BPS</b>. Jangan dikunci ke dokumen
                        perizinan sebelum diverifikasi — Lampiran A butir A9.
                    </div>
                    <group>
                        <group>
                            <field name="version"/>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="section"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="risk_level"/>
                            <field name="permit_form"/>
                            <field name="is_verified"/>
                            <field name="source_note"/>
                        </group>
                    </group>
                    <group string="Padanan Versi Lain">
                        <field name="counterpart_ids" widget="many2many_tags" nolabel="1"/>
                        <div class="text-muted small" colspan="2">
                            Many2many karena konversi KBLI tidak selalu satu-ke-satu: satu kode
                            lama dapat pecah menjadi beberapa kode baru, dan sebaliknya.
                        </div>
                    </group>
                    <group string="Persyaratan Operasional">
                        <field name="requirement_note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_lgx_kbli_search" model="ir.ui.view">
        <field name="name">lgx.kbli.search</field>
        <field name="model">lgx.kbli</field>
        <field name="arch" type="xml">
            <search string="KBLI">
                <field name="code"/>
                <field name="name"/>
                <filter name="f_2025" string="KBLI 2025" domain="[('version','=','2025')]"/>
                <filter name="f_2020" string="KBLI 2020" domain="[('version','=','2020')]"/>
                <filter name="f_unverified" string="Belum Terverifikasi"
                        domain="[('is_verified','=',False)]"/>
                <filter name="f_no_map" string="Tanpa Padanan" domain="[('counterpart_ids','=',False)]"/>
                <separator/>
                <filter name="g_version" string="Versi" context="{'group_by':'version'}"/>
                <filter name="g_risk" string="Tingkat Risiko" context="{'group_by':'risk_level'}"/>
            </search>
        </field>
    </record>
    <record id="action_lgx_kbli" model="ir.actions.act_window">
        <field name="name">KBLI</field>
        <field name="res_model">lgx.kbli</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_g_version': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_tutorial">
                Daftar bawaan hanya kode yang relevan logistik. KBLI lengkap (~1.700 kode per
                versi) dimuat lewat <code>lgx.kbli.lgx_import_csv</code> dari ekspor resmi
                BPS/OSS. Baris bertanda peringatan belum dikonfirmasi ke sumber primer.
            </p>
        </field>
    </record>
    <menuitem id="menu_lgx_kbli" name="KBLI" parent="menu_lgx_config_reference"
              action="action_lgx_kbli" sequence="120"/>
</odoo>
