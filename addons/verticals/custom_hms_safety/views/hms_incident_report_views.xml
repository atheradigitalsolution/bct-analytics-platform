<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hms_incident_report_list" model="ir.ui.view">
        <field name="name">hms.incident.report.list</field>
        <field name="model">hms.incident.report</field>
        <field name="arch" type="xml">
            <list string="Insiden Keselamatan Pasien"
                  decoration-danger="grade == 'red' or is_late"
                  decoration-warning="grade == 'yellow'"
                  decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="occurred_at"/>
                <field name="unit_id"/>
                <field name="incident_type"/>
                <field name="category"/>
                <field name="reporter_display" string="Pelapor"/>
                <field name="due_at" optional="show"/>
                <field name="reported_at" optional="hide"/>
                <field name="is_late" string="Terlambat"/>
                <field name="grade" widget="badge" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hms_incident_report_form" model="ir.ui.view">
        <field name="name">hms.incident.report.form</field>
        <field name="model">hms.incident.report</field>
        <field name="arch" type="xml">
            <form string="Laporan Insiden Keselamatan Pasien">
                <header>
                    <button name="action_report" type="object" string="Kirim Laporan"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start_investigation" type="object"
                            string="Mulai Investigasi" class="btn-primary"
                            groups="custom_hms_safety.group_hms_patient_safety"
                            invisible="state != 'reported'"/>
                    <button name="action_grade" type="object" string="Tetapkan Grading"
                            class="btn-primary"
                            groups="custom_hms_safety.group_hms_patient_safety"
                            invisible="state != 'investigating'"/>
                    <button name="action_close" type="object" string="Tutup Laporan"
                            groups="custom_hms_safety.group_hms_patient_safety"
                            invisible="state != 'graded'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,reported,investigating,graded,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Terlambat &gt; batas lapor"
                            bg_color="text-bg-danger" invisible="not is_late"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Pelapor">
                            <field name="is_anonymous"/>
                            <field name="reporter_id" invisible="is_anonymous"
                                   readonly="state != 'draft'"/>
                            <field name="reporter_display" invisible="not is_anonymous"/>
                            <field name="reporter_unit_id"/>
                        </group>
                        <group string="Tenggat Pelaporan">
                            <field name="due_hours_applied"/>
                            <field name="due_at"/>
                            <field name="reported_at"/>
                            <field name="is_late"/>
                            <field name="late_hours" invisible="not is_late"/>
                        </group>
                    </group>
                    <group>
                        <group string="Kejadian">
                            <field name="occurred_at" readonly="state != 'draft'"/>
                            <field name="unit_id"/>
                            <field name="location_detail"/>
                            <field name="incident_type"/>
                            <field name="category"/>
                        </group>
                        <group string="Pasien Terkait (opsional)">
                            <field name="patient_id"/>
                            <field name="encounter_id"
                                   domain="[('patient_id', '=', patient_id)]"/>
                            <field name="patient_harmed"/>
                            <field name="witness_names"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Kronologi &amp; Tindakan Segera">
                            <field name="chronology" placeholder="Urutan kejadian apa adanya, tanpa menilai siapa yang salah."/>
                            <separator string="Tindakan Segera"/>
                            <field name="immediate_action"/>
                        </page>
                        <page string="Investigasi &amp; Grading"
                              groups="custom_hms_safety.group_hms_patient_safety">
                            <group>
                                <group>
                                    <field name="investigator_id"/>
                                    <field name="investigation_started_at"/>
                                    <field name="grade"/>
                                    <field name="investigation_method"/>
                                </group>
                                <group>
                                    <field name="graded_by_id"/>
                                    <field name="graded_at"/>
                                    <field name="closed_by_id"/>
                                    <field name="closed_at"/>
                                </group>
                            </group>
                            <separator string="Akar Masalah"/>
                            <field name="root_cause"/>
                            <separator string="Rekomendasi Perbaikan"/>
                            <field name="recommendation"/>
                            <separator string="Catatan Penutupan"/>
                            <field name="closure_note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hms_incident_report_search" model="ir.ui.view">
        <field name="name">hms.incident.report.search</field>
        <field name="model">hms.incident.report</field>
        <field name="arch" type="xml">
            <search string="Cari Insiden">
                <field name="name"/>
                <field name="unit_id"/>
                <field name="patient_id"/>
                <filter name="filter_open" string="Belum Ditutup"
                        domain="[('state', '!=', 'closed')]"/>
                <filter name="filter_late" string="Terlambat Lapor"
                        domain="[('is_late', '=', True)]"/>
                <filter name="filter_sentinel" string="Sentinel / Merah"
                        domain="['|', ('incident_type', '=', 'sentinel'), ('grade', '=', 'red')]"/>
                <separator/>
                <filter name="group_type" string="Jenis Insiden"
                        context="{'group_by': 'incident_type'}"/>
                <filter name="group_category" string="Kategori"
                        context="{'group_by': 'category'}"/>
                <filter name="group_grade" string="Grading" context="{'group_by': 'grade'}"/>
                <filter name="group_unit" string="Unit" context="{'group_by': 'unit_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_hms_incident_report" model="ir.actions.act_window">
        <field name="name">Insiden Keselamatan Pasien</field>
        <field name="res_model">hms.incident.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hms_incident_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Belum ada laporan insiden.</p>
            <p>Setiap staf boleh melapor; hanya Tim Keselamatan Pasien yang membaca
               seluruh laporan. Tenggat pelaporan internal mengikuti parameter
               rumah sakit (PMK 11/2017: paling lambat 2x24 jam).</p>
        </field>
    </record>
</odoo>
