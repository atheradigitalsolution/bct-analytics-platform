<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_hms_incident_report" model="ir.sequence">
            <field name="name">Nomor Laporan IKP</field>
            <field name="code">hms.incident.report</field>
            <field name="prefix">IKP-%(year)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="implementation">standard</field>
            <field name="use_date_range" eval="True"/>
        </record>
        <record id="seq_hms_complaint" model="ir.sequence">
            <field name="name">Nomor Komplain</field>
            <field name="code">hms.complaint</field>
            <field name="prefix">KMP-%(year)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="implementation">standard</field>
            <field name="use_date_range" eval="True"/>
        </record>
    </data>
</odoo>
