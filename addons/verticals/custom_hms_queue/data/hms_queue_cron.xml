<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            The outbox publishes on post-commit, so this cron is only a sweeper
            for events Redis refused. One minute is Odoo's floor and is fine
            for that role; it is NOT the path that keeps the queue display
            under two seconds.
        -->
        <record id="cron_hms_event_publish" model="ir.cron">
            <field name="name">SIMRS: kirim ulang event outbox yang tertinggal</field>
            <field name="model_id" ref="model_hms_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_publish_pending()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_hms_event_gc" model="ir.cron">
            <field name="name">SIMRS: bersihkan event yang sudah terkirim</field>
            <field name="model_id" ref="model_hms_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_gc()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_hms_job_run" model="ir.cron">
            <field name="name">SIMRS: jalankan job integrasi</field>
            <field name="model_id" ref="model_hms_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_run()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_hms_job_unstick" model="ir.cron">
            <field name="name">SIMRS: bebaskan job yang tersangkut</field>
            <field name="model_id" ref="model_hms_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_unstick()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_hms_bridging_log_gc" model="ir.cron">
            <field name="name">SIMRS: retensi log bridging</field>
            <field name="model_id" ref="model_hms_bridging_log"/>
            <field name="state">code</field>
            <field name="code">model._gc()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
