<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_lgx_nle" model="ir.ui.view">
        <field name="name">res.config.settings.form.lgx.nle</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="custom_lgx_billing.res_config_settings_view_form_lgx"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='custom_lgx_billing']" position="inside">
                <block title="Integrasi NLE / INSW"
                       help="DO Online, SP2, dan rekonsiliasi status dokumen serta kontainer.">
                    <setting string="Aktifkan NLE / INSW">
                        <field name="lgx_nle_enabled"/>
                    </setting>
                    <setting string="Base URL NLE"
                             help="Produksi https://api.beacukai.go.id; pengembangan http://lgx-mock:4020.">
                        <field name="lgx_nle_base_url"/>
                    </setting>
                    <setting string="API Key">
                        <field name="lgx_nle_api_key" password="True"/>
                    </setting>
                    <setting string="ID Platform"
                             help="Diperoleh lewat registrasi ke NLE. Request tanpa ini ditolak, dan penolakannya tidak menyebutkan penyebabnya.">
                        <field name="lgx_nle_id_platform"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
