<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lgx_shipment_form_nle" model="ir.ui.view">
        <field name="name">lgx.shipment.form.nle</field>
        <field name="model">lgx.shipment</field>
        <field name="inherit_id" ref="custom_lgx_ff.view_lgx_shipment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_request_do_online" type="object" string="Minta DO Online"
                        invisible="nle_do_id or state == 'draft'"/>
                <button name="action_request_sp2" type="object" string="Minta SP2"
                        invisible="nle_sp2_number or state == 'draft'"/>
                <button name="action_pull_nle_status" type="object" string="Tarik Status NLE"
                        invisible="state == 'draft'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="NLE / INSW" name="nle">
                    <div class="alert alert-info" role="alert">
                        Status yang ditarik menjadi milestone dengan sumber <code>nle</code>.
                        Sumbernya disimpan justru karena penting: saat pelanggan menanyakan
                        kenapa ETA berubah, "siapa yang bilang" adalah setengah dari jawabannya.
                    </div>
                    <group>
                        <group>
                            <field name="nle_do_number" readonly="1"/>
                            <field name="nle_do_id" readonly="1"/>
                            <field name="nle_sp2_number" readonly="1"/>
                        </group>
                        <group>
                            <field name="nle_last_document_status" readonly="1"/>
                            <field name="nle_last_sync" readonly="1"/>
                        </group>
                    </group>
                    <field name="nle_message_ids" readonly="1">
                        <list decoration-danger="state == 'failed'"
                              decoration-info="state == 'pending'">
                            <field name="create_date"/>
                            <field name="direction"/>
                            <field name="endpoint"/>
                            <field name="http_status"/>
                            <field name="attempt_count"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
