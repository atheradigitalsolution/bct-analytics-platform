<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hms_payer_list" model="ir.ui.view">
        <field name="name">hms.payer.list</field>
        <field name="model">hms.payer</field>
        <field name="arch" type="xml">
            <list string="Penjamin">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="type"/>
                <field name="partner_id"/>
                <field name="requires_sep"/>
                <field name="requires_guarantee_letter"/>
                <field name="contract_valid_to"/>
            </list>
        </field>
    </record>
    <record id="view_hms_payer_form" model="ir.ui.view">
        <field name="name">hms.payer.form</field>
        <field name="model">hms.payer</field>
        <field name="arch" type="xml">
            <form string="Penjamin">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="type"/>
                            <field name="partner_id"
                                   help="Kosong untuk penjamin Umum: tagihan atas nama pasien."/>
                            <field name="payment_term_id"/>
                        </group>
                        <group>
                            <field name="requires_sep"/>
                            <field name="requires_guarantee_letter"/>
                            <field name="cob_order"/>
                            <field name="aps_covered"/>
                            <field name="contract_no"/>
                            <field name="contract_valid_to"/>
                            <field name="contact_person"/>
                            <field name="contact_phone"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Plan / Produk">
                            <field name="plan_ids">
                                <list editable="bottom">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="class_id"/>
                                    <field name="coverage_percent"/>
                                    <field name="plafon_per_visit"/>
                                    <field name="copay_amount"/>
                                    <field name="upgrade_class_rule"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Checklist Klaim">
                            <field name="claim_document_checklist"
                                   placeholder="Satu dokumen per baris"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_hms_payer" model="ir.actions.act_window">
        <field name="name">Penjamin</field>
        <field name="res_model">hms.payer</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_hms_payer" name="Penjamin" parent="menu_hms_config_tariff"
              action="action_hms_payer" sequence="10"/>
</odoo>
