<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Merged patient records stay in the database for referential
            integrity but must not surface in searches — a clerk who registers
            against the retired record re-splits the very duplicate that was
            just merged. Administrators keep sight of them.
        -->
        <record id="rule_hms_patient_not_merged" model="ir.rule">
            <field name="name">Pasien: sembunyikan rekam yang sudah digabung</field>
            <field name="model_id" ref="model_hms_patient"/>
            <field name="domain_force">[('state', '!=', 'merged')]</field>
            <field name="groups" eval="[(4, ref('group_hms_staff'))]"/>
        </record>
        <record id="rule_hms_patient_admin_all" model="ir.rule">
            <field name="name">Pasien: administrator melihat semua</field>
            <field name="model_id" ref="model_hms_patient"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_hms_registration_manager')), (4, ref('group_hms_admin'))]"/>
        </record>
    </data>
</odoo>
