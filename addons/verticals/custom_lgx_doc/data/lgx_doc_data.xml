<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_lgx_document_expiry" model="ir.cron">
            <field name="name">LGX: peringatan masa berlaku dokumen (mesin generik)</field>
            <field name="model_id" ref="model_lgx_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_warn_expiring()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Checklist dokumen per jenis job. Yang menghalangi milestone adalah
             dokumen yang ketiadaannya benar-benar menghentikan barang, bukan
             semua dokumen yang ideal ada. -->
        <record id="checklist_ff_import_sea_bl" model="lgx.document.checklist.template">
            <field name="job_type">ff_import</field><field name="transport_mode">sea</field>
            <field name="document_type_id" ref="custom_lgx_base.doctype_hbl"/>
            <field name="is_mandatory">1</field><field name="sequence">10</field>
        </record>
        <record id="checklist_ff_import_sea_pl" model="lgx.document.checklist.template">
            <field name="job_type">ff_import</field><field name="transport_mode">sea</field>
            <field name="document_type_id" ref="custom_lgx_base.doctype_packing"/>
            <field name="is_mandatory">1</field><field name="sequence">20</field>
            <field name="blocks_milestone_code">customs_submitted</field>
        </record>
        <record id="checklist_ff_import_sea_ci" model="lgx.document.checklist.template">
            <field name="job_type">ff_import</field><field name="transport_mode">sea</field>
            <field name="document_type_id" ref="custom_lgx_base.doctype_ci"/>
            <field name="is_mandatory">1</field><field name="sequence">30</field>
            <field name="blocks_milestone_code">customs_submitted</field>
        </record>
        <record id="checklist_ff_import_sea_sppb" model="lgx.document.checklist.template">
            <field name="job_type">ff_import</field><field name="transport_mode">sea</field>
            <field name="document_type_id" ref="custom_lgx_base.doctype_sppb"/>
            <field name="is_mandatory">1</field><field name="sequence">40</field>
            <field name="blocks_milestone_code">container_picked_up</field>
        </record>
        <record id="checklist_ff_import_sea_do" model="lgx.document.checklist.template">
            <field name="job_type">ff_import</field><field name="transport_mode">sea</field>
            <field name="document_type_id" ref="custom_lgx_base.doctype_do"/>
            <field name="is_mandatory">1</field><field name="sequence">50</field>
            <field name="blocks_milestone_code">container_picked_up</field>
        </record>
        <record id="checklist_ff_export_sea_peb" model="lgx.document.checklist.template">
            <field name="job_type">ff_export</field><field name="transport_mode">sea</field>
            <field name="document_type_id" ref="custom_lgx_base.doctype_peb"/>
            <field name="is_mandatory">1</field><field name="sequence">10</field>
            <field name="blocks_milestone_code">loaded_on_vessel</field>
        </record>
        <record id="checklist_ff_export_sea_pl" model="lgx.document.checklist.template">
            <field name="job_type">ff_export</field><field name="transport_mode">sea</field>
            <field name="document_type_id" ref="custom_lgx_base.doctype_packing"/>
            <field name="is_mandatory">1</field><field name="sequence">20</field>
        </record>
        <record id="checklist_trucking_sj" model="lgx.document.checklist.template">
            <field name="job_type">trucking</field><field name="transport_mode">land</field>
            <field name="document_type_id" ref="custom_lgx_base.doctype_sj"/>
            <field name="is_mandatory">1</field><field name="sequence">10</field>
        </record>
        <record id="checklist_trucking_pod" model="lgx.document.checklist.template">
            <field name="job_type">trucking</field><field name="transport_mode">land</field>
            <field name="document_type_id" ref="custom_lgx_base.doctype_pod"/>
            <field name="is_mandatory">1</field><field name="sequence">20</field>
        </record>
        <record id="checklist_warehouse_grn" model="lgx.document.checklist.template">
            <field name="job_type">warehouse</field><field name="transport_mode">any</field>
            <field name="document_type_id" ref="custom_lgx_base.doctype_grn"/>
            <field name="is_mandatory">1</field><field name="sequence">10</field>
        </record>
        <record id="checklist_customs_only_ci" model="lgx.document.checklist.template">
            <field name="job_type">customs_only</field><field name="transport_mode">any</field>
            <field name="document_type_id" ref="custom_lgx_base.doctype_ci"/>
            <field name="is_mandatory">1</field><field name="sequence">10</field>
            <field name="blocks_milestone_code">customs_submitted</field>
        </record>
    </data>
</odoo>
