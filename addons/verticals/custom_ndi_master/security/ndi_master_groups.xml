<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="res_groups_privilege_ndi" model="res.groups.privilege">
            <field name="name">NDI Feed Mill</field>
            <field name="sequence">150</field>
        </record>

        <!-- Membaca master: kasir, sales, produksi. -->
        <record id="group_ndi_master_user" model="res.groups">
            <field name="name">NDI Feed Mill / Master Data User</field>
            <field name="privilege_id" ref="res_groups_privilege_ndi"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Merawat divisi, kategori, UoM dan berat gross. -->
        <record id="group_ndi_master_manager" model="res.groups">
            <field name="name">NDI Feed Mill / Master Data Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_ndi"/>
            <field name="implied_ids" eval="[(4, ref('group_ndi_master_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
