<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hms_eklaim_code_list" model="ir.ui.view">
        <field name="name">hms.eklaim.code.list</field>
        <field name="model">hms.eklaim.code</field>
        <field name="arch" type="xml">
            <list string="Master Kode E-Klaim" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="category"/>
                <field name="code"/>
                <field name="label"/>
                <field name="source_document"/>
                <field name="note" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hms_eklaim_code_search" model="ir.ui.view">
        <field name="name">hms.eklaim.code.search</field>
        <field name="model">hms.eklaim.code</field>
        <field name="arch" type="xml">
            <search string="Cari Kode E-Klaim">
                <field name="code"/>
                <field name="label"/>
                <field name="category"/>
                <filter name="filter_unsourced" string="Belum Ada Dokumen Sumber"
                        domain="[('source_document', '=', False)]"/>
                <separator/>
                <filter name="group_category" string="Kategori"
                        context="{'group_by': 'category'}"/>
            </search>
        </field>
    </record>

    <record id="action_hms_eklaim_code" model="ir.actions.act_window">
        <field name="name">Master Kode E-Klaim</field>
        <field name="res_model">hms.eklaim.code</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hms_eklaim_code_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Master kode E-Klaim masih kosong — dan itu disengaja.</p>
            <p>Enumerasi E-Klaim (<code>jenis_rawat</code>, <code>cara_masuk</code>,
               <code>discharge_status</code>, <code>kode_tarif</code>,
               <code>payor_id</code>, komponen <code>tarif_rs</code>) tidak ditebak
               di dalam kode. Isi tabel ini dengan mengimpor dari manual resmi WS
               E-Klaim, dan cantumkan judul serta versi manualnya pada kolom
               Dokumen Sumber.</p>
        </field>
    </record>

    <record id="view_hms_eklaim_config_form" model="ir.ui.view">
        <field name="name">hms.eklaim.config.form</field>
        <field name="model">hms.eklaim.config</field>
        <field name="arch" type="xml">
            <form string="Parameter E-Klaim">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <b>Bridging E-Klaim belum dibangun.</b> Parameter di halaman ini
                        adalah tempat menaruh nilai dari manual resmi WS E-Klaim 5.10.x
                        begitu manualnya ada. Selama itu belum, klaim disusun,
                        diverifikasi dan difinalkan di SIMRS lalu dikirim lewat aplikasi
                        E-Klaim seperti biasa.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="grouper_mode" readonly="1"/>
                        </group>
                        <group>
                            <field name="base_url" placeholder="(menunggu manual resmi)"/>
                            <field name="kode_tarif" placeholder="(menunggu manual resmi)"/>
                            <field name="payor_id" placeholder="(menunggu manual resmi)"/>
                            <field name="default_coder_nik"/>
                        </group>
                    </group>
                    <group string="Status Kesiapan">
                        <field name="readiness_note" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hms_eklaim_config_list" model="ir.ui.view">
        <field name="name">hms.eklaim.config.list</field>
        <field name="model">hms.eklaim.config</field>
        <field name="arch" type="xml">
            <list string="Parameter E-Klaim">
                <field name="name"/>
                <field name="company_id"/>
                <field name="base_url"/>
                <field name="kode_tarif"/>
                <field name="payor_id"/>
            </list>
        </field>
    </record>

    <record id="action_hms_eklaim_config" model="ir.actions.act_window">
        <field name="name">Parameter E-Klaim</field>
        <field name="res_model">hms.eklaim.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
