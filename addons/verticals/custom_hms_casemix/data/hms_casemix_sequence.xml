<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_hms_claim" model="ir.sequence">
            <field name="name">Nomor Klaim</field>
            <field name="code">hms.claim</field>
            <field name="prefix">CLM-%(year)s%(month)s-</field>
            <field name="padding">5</field>
            <field name="implementation">standard</field>
            <field name="use_date_range" eval="True"/>
        </record>
        <record id="seq_hms_coding_query" model="ir.sequence">
            <field name="name">Nomor Pertanyaan Koder</field>
            <field name="code">hms.coding.query</field>
            <field name="prefix">CQ-%(year)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="implementation">standard</field>
            <field name="use_date_range" eval="True"/>
        </record>
        <record id="seq_hms_claim_batch" model="ir.sequence">
            <field name="name">Nomor Batch Klaim</field>
            <field name="code">hms.claim.batch</field>
            <field name="prefix">BTC-%(year)s%(month)s-</field>
            <field name="padding">3</field>
            <field name="implementation">standard</field>
            <field name="use_date_range" eval="True"/>
        </record>
        <record id="seq_hms_claim_adjustment" model="ir.sequence">
            <field name="name">Nomor Penyesuaian Klaim</field>
            <field name="code">hms.claim.adjustment</field>
            <field name="prefix">ADJ-%(year)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="implementation">standard</field>
            <field name="use_date_range" eval="True"/>
        </record>
    </data>
</odoo>
