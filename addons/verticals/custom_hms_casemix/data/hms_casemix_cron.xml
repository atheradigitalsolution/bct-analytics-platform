<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Kedaluwarsa ditandai cron, bukan hanya saat tombol ditekan.

            Klaim yang lewat enam bulan dan tidak pernah dibuka lagi akan
            selamanya tampak "masih dikerjakan" di daftar kerja, dan
            kerugiannya tidak pernah masuk pembukuan. Cron harian
            memindahkannya ke `expired` supaya muncul sebagai apa adanya:
            uang yang tidak akan datang.
        -->
        <record id="cron_hms_claim_expire" model="ir.cron">
            <field name="name">SIMRS: tandai klaim yang lewat batas pengajuan</field>
            <field name="model_id" ref="model_hms_claim"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_claims()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
