<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_lgx_tax" model="ir.ui.view">
        <field name="name">account.move.form.lgx.tax</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Pajak Logistik" name="lgx_tax" invisible="not lgx_job_id">
                    <div class="alert alert-warning" role="alert" invisible="not lgx_vat_warning">
                        <field name="lgx_vat_warning" nolabel="1" readonly="1"/>
                    </div>
                    <group>
                        <group string="PPN">
                            <field name="lgx_vat_treatment"/>
                            <field name="lgx_has_freight_charge" readonly="1"/>
                            <field name="lgx_faktur_code"/>
                            <field name="lgx_input_vat_not_creditable" readonly="1"/>
                            <field name="lgx_nitku"/>
                        </group>
                        <group string="Pot-Put">
                            <field name="lgx_wht_type" readonly="1"/>
                            <field name="lgx_wht_base" readonly="1"/>
                            <field name="lgx_wht_excluded" readonly="1"/>
                            <field name="lgx_wht_rate" readonly="1"/>
                            <field name="lgx_wht_amount" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="not lgx_wht_excluded">
                        Nilai yang dikecualikan adalah baris <b>talangan pihak ketiga</b>.
                        PMK 141/2015: jumlah bruto tidak termasuk reimbursement sepanjang dapat
                        dibuktikan dengan faktur tagihan dan/atau bukti pembayaran dari pihak
                        ketiga. Bukti itu diperiksa sebelum posting, bukan diingatkan saja.
                    </div>
                    <group string="Dasar Pembebasan Angkutan Umum"
                           invisible="lgx_vat_treatment != 'exempt_public_transport'">
                        <field name="lgx_exemption_basis" nolabel="1"
                               placeholder="Bukan sewa/charter; bukan mengangkut barang satu pihak dalam satu perjalanan tertentu; dasar kontraktualnya ..."/>
                    </group>
                    <group string="Dokumen Ekspor Jasa 0%"
                           invisible="lgx_vat_treatment != 'export_service_zero'">
                        <div class="alert alert-danger" role="alert" colspan="2"
                             invisible="lgx_export_contract_ids and lgx_export_payment_proof_ids">
                            Kedua dokumen ini WAJIB sebelum faktur dapat diposting
                            (PMK 32/PMK.010/2019). Fasilitas tarif nol yang tidak dapat
                            dibuktikan akan gugur saat pemeriksaan.
                        </div>
                        <field name="lgx_export_contract_ids" widget="many2many_binary"/>
                        <field name="lgx_export_payment_proof_ids" widget="many2many_binary"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
    <record id="view_lgx_wht_rate_list" model="ir.ui.view">
        <field name="name">lgx.wht.rate.list</field>
        <field name="model">lgx.wht.rate</field>
        <field name="arch" type="xml">
            <list string="Tarif Pot-Put" editable="bottom">
                <field name="wht_type"/>
                <field name="name"/>
                <field name="rate"/>
                <field name="rate_no_npwp"/>
                <field name="is_final"/>
                <field name="legal_basis"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_lgx_wht_rate" model="ir.actions.act_window">
        <field name="name">Tarif Pot-Put Logistik</field>
        <field name="res_model">lgx.wht.rate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
