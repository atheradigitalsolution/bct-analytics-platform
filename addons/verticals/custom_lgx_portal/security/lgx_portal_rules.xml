<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            LAPIS KEDUA. Controller sudah menyaring; ini menyaring lagi.

            Bukan paranoia. Template QWeb adalah tempat orang menambahkan
            `t-foreach` baru tanpa memikirkan siapa yang membacanya, dan satu
            baris ceroboh di sana akan membocorkan milestone internal — "biaya
            vendor diterima", "kontainer kena detensi" — ke layar pelanggan.
            Lapis kedua membuat kecerobohan itu tidak cukup untuk bocor.
        -->
        <record id="rule_lgx_job_portal" model="ir.rule">
            <field name="name">Job: pengguna portal hanya melihat miliknya</field>
            <field name="model_id" ref="custom_lgx_job.model_lgx_job"/>
            <field name="domain_force">[('customer_id','=',user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_lgx_milestone_portal" model="ir.rule">
            <field name="name">Milestone: portal hanya yang terlihat pelanggan</field>
            <field name="model_id" ref="custom_lgx_job.model_lgx_milestone"/>
            <field name="domain_force">[('is_customer_visible','=',True),('job_id.customer_id','=',user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_lgx_document_portal" model="ir.rule">
            <field name="name">Dokumen: portal hanya yang terlihat pelanggan</field>
            <field name="model_id" ref="custom_lgx_doc.model_lgx_document"/>
            <field name="domain_force">[('is_customer_visible','=',True),('job_id.customer_id','=',user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_lgx_shipment_portal" model="ir.rule">
            <field name="name">Shipment: portal hanya miliknya</field>
            <field name="model_id" ref="custom_lgx_ff.model_lgx_shipment"/>
            <field name="domain_force">[('job_id.customer_id','=',user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_lgx_container_portal" model="ir.rule">
            <field name="name">Kontainer: portal hanya miliknya</field>
            <field name="model_id" ref="custom_lgx_ff.model_lgx_container"/>
            <field name="domain_force">[('job_id.customer_id','=',user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
