<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Masa berlaku tautan pelacakan publik.

            Default 72 jam, bukan selamanya. Nomor B/L beredar di rantai pasok —
            di surel, di grup pesan, di berkas Excel yang diteruskan — dan tautan
            abadi yang ikut beredar bersamanya adalah pintu yang tidak pernah
            tertutup.
        -->
        <record id="param_track_link_ttl" model="ir.config_parameter">
            <field name="key">lgx.track_link_ttl_hours</field>
            <field name="value">72</field>
        </record>
    </data>
</odoo>
