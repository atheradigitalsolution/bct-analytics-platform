<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Analisis ulang berkala.

            PPA melengkapi berkas lewat modul lain (catatan klinis, resume,
            persetujuan), dan modul-modul itu sengaja tidak tahu apa-apa
            tentang KLPCM. Cron ini yang menutup lingkarannya, sehingga baris
            KLPCM tidak pernah bergantung pada satu modul ingat memanggil
            modul lain — ketergantungan yang selalu putus di modul berikutnya
            yang ditulis orang lain.

            Setengah jam, bukan setiap menit: tenggat KLPCM diukur dalam jam
            (2x24), jadi keterlambatan setengah jam tidak mengubah apa pun,
            sementara pemindaian per menit atas seluruh kunjungan terbuka
            mengubah banyak hal pada beban basis data.
        -->
        <record id="cron_hms_klpcm_reanalyze" model="ir.cron">
            <field name="name">SIMRS: analisis ulang kelengkapan berkas (KLPCM)</field>
            <field name="model_id" ref="model_hms_klpcm"/>
            <field name="state">code</field>
            <field name="code">model._cron_reanalyze_open()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_hms_retention_reviews" model="ir.cron">
            <field name="name">SIMRS: susun daftar tinjauan retensi rekam medis</field>
            <field name="model_id" ref="model_hms_retention_review"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_reviews()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
