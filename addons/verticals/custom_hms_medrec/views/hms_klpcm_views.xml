<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hms_klpcm_list" model="ir.ui.view">
        <field name="name">hms.klpcm.list</field>
        <field name="model">hms.klpcm</field>
        <field name="arch" type="xml">
            <list string="Ketidaklengkapan Berkas (KLPCM)"
                  decoration-danger="is_overdue"
                  decoration-muted="state == 'completed'">
                <field name="encounter_id"/>
                <field name="patient_id"/>
                <field name="unit_id" optional="show"/>
                <field name="component"/>
                <field name="detail"/>
                <field name="kind" optional="hide"/>
                <field name="responsible_id"/>
                <field name="due_at"/>
                <field name="is_overdue" string="Lewat Tenggat"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hms_klpcm_form" model="ir.ui.view">
        <field name="name">hms.klpcm.form</field>
        <field name="model">hms.klpcm</field>
        <field name="arch" type="xml">
            <form string="Temuan KLPCM">
                <sheet>
                    <widget name="web_ribbon" title="Lewat tenggat" bg_color="text-bg-danger"
                            invisible="not is_overdue"/>
                    <div class="oe_title">
                        <h1><field name="component" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Berkas">
                            <field name="encounter_id" readonly="1"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="unit_id" readonly="1"/>
                            <field name="kind" readonly="1"/>
                            <field name="auto_detected" readonly="1"/>
                        </group>
                        <group string="Penyelesaian">
                            <field name="responsible_id"/>
                            <field name="due_hours_applied" readonly="1"/>
                            <field name="due_at" readonly="1"/>
                            <field name="analyzed_at" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="closed_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Rincian Temuan">
                        <field name="detail" nolabel="1" readonly="1"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Temuan ini tertutup sendiri begitu dokumennya dilengkapi —
                        tidak ada tombol "tandai lengkap". Lengkapi berkasnya lewat
                        entri baru, lalu jalankan analisis ulang dari layar kunjungan.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hms_klpcm_search" model="ir.ui.view">
        <field name="name">hms.klpcm.search</field>
        <field name="model">hms.klpcm</field>
        <field name="arch" type="xml">
            <search string="Cari KLPCM">
                <field name="encounter_id"/>
                <field name="patient_id"/>
                <field name="responsible_id"/>
                <field name="unit_id"/>
                <filter name="filter_open" string="Terbuka" domain="[('state', '=', 'open')]"/>
                <filter name="filter_overdue" string="Lewat Tenggat"
                        domain="[('is_overdue', '=', True)]"/>
                <separator/>
                <filter name="group_component" string="Komponen"
                        context="{'group_by': 'component'}"/>
                <filter name="group_responsible" string="Penanggung Jawab"
                        context="{'group_by': 'responsible_id'}"/>
                <filter name="group_unit" string="Unit" context="{'group_by': 'unit_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_hms_klpcm" model="ir.actions.act_window">
        <field name="name">Kelengkapan Berkas (KLPCM)</field>
        <field name="res_model">hms.klpcm</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="search_view_id" ref="view_hms_klpcm_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Tidak ada berkas yang tertahan.</p>
            <p>Baris di sini muncul sendiri saat kunjungan ditutup atau pasien
               dipulangkan, dan tertutup sendiri saat dokumennya dilengkapi.
               Selama masih ada baris terbuka, kunjungannya tidak dapat masuk
               koding klaim.</p>
        </field>
    </record>

    <record id="view_hms_encounter_form_klpcm" model="ir.ui.view">
        <field name="name">hms.encounter.form.klpcm</field>
        <field name="model">hms.encounter</field>
        <field name="inherit_id" ref="custom_hms_registration.view_hms_encounter_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_reanalyze_klpcm" type="object"
                        string="Analisis Ulang Kelengkapan"
                        groups="custom_hms_medrec.group_hms_medrec"
                        invisible="state not in ('finished', 'discharged')"/>
            </xpath>
        </field>
    </record>
</odoo>
