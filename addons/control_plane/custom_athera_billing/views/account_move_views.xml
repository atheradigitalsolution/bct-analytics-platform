<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_move_form_athera_billing" model="ir.ui.view">
    <field name="name">account.move.form.athera.billing</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='invoice_date']" position="after">
        <field name="athera_subscription_id" invisible="not athera_subscription_id"/>
        <field name="athera_period_start" invisible="not athera_subscription_id"/>
        <field name="athera_period_end" invisible="not athera_subscription_id"/>
        <field name="athera_access_applied" invisible="not athera_subscription_id"/>
        <field name="athera_arrears_enforced" invisible="not athera_subscription_id"/>
      </xpath>
    </field>
  </record>
</odoo>
