<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_athera_subscription_list" model="ir.ui.view">
    <field name="name">athera.subscription.list</field>
    <field name="model">athera.subscription</field>
    <field name="arch" type="xml">
      <list decoration-danger="state == 'suspended'" decoration-muted="state == 'cancelled'">
        <field name="tenant_slug"/>
        <field name="partner_id"/>
        <field name="plan_code"/>
        <field name="products"/>
        <field name="price_month" widget="monetary"/>
        <field name="currency_id" column_invisible="True"/>
        <field name="next_invoice_date"/>
        <field name="grace_days"/>
        <field name="invoice_count" string="Faktur"/>
        <field name="state" widget="badge"
               decoration-success="state == 'active'" decoration-danger="state == 'suspended'"/>
      </list>
    </field>
  </record>

  <record id="view_athera_subscription_form" model="ir.ui.view">
    <field name="name">athera.subscription.form</field>
    <field name="model">athera.subscription</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_activate" type="object" string="Aktifkan" class="btn-primary"
                  invisible="state == 'active'"/>
          <button name="action_create_invoice_now" type="object" string="Terbitkan faktur"
                  invisible="state != 'active'"/>
          <button name="action_cancel" type="object" string="Batalkan"
                  invisible="state == 'cancelled'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,active,suspended"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o">
              <field name="invoice_count" widget="statinfo" string="Faktur"/>
            </button>
          </div>
          <group>
            <group string="Tenant">
              <field name="tenant_slug"/>
              <field name="partner_id"/>
              <field name="plan_code"/>
              <field name="products" readonly="1"/>
            </group>
            <group string="Penagihan">
              <field name="currency_id" invisible="1"/>
              <field name="price_month" widget="monetary" readonly="1"/>
              <field name="date_start"/>
              <field name="next_invoice_date"/>
              <field name="grace_days_override"/>
              <field name="grace_days" readonly="1"/>
            </group>
          </group>
          <div class="alert alert-info" role="alert">
            Harga dibaca langsung dari <code>tenant_registry.plans</code> setiap kali faktur dibuat.
            Editornya ada di hub-portal <code>/pricing</code>; mengubahnya di sini tidak mungkin,
            dan itu disengaja — satu harga, satu tempat.
          </div>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_athera_subscription" model="ir.actions.act_window">
    <field name="name">Langganan</field>
    <field name="res_model">athera.subscription</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
