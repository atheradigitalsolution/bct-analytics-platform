<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!--
      Masa tenggang sejak jatuh tempo sampai akses ditutup. Keputusan user 2026-09-03: 14 hari,
      dan harus bisa diatur — jadi ia parameter yang bisa disunting operator, bukan konstanta di
      dalam kode. `noupdate` supaya nilai yang sudah disunting tidak dikembalikan saat upgrade.
    -->
    <record id="param_grace_days" model="ir.config_parameter">
      <field name="key">athera_billing.grace_days</field>
      <field name="value">14</field>
    </record>

    <!--
      Tenant yang boleh ditagih selama NPWP perusahaan belum sungguhan. Sengaja KOSONG di repo:
      daftar percontohan adalah kenyataan lokal sebuah instalasi, bukan bagian dari produk. Kosong
      berarti menolak semua, dan itu bawaan yang benar — sebuah instalasi baru belum punya NPWP.
    -->
    <!--
      Tempo pembayaran: hari sejak faktur terbit sampai jatuh tempo. Tanpa parameter ini Odoo
      memakai tanggal faktur itu sendiri, sehingga setiap faktur lahir dalam keadaan jatuh tempo
      dan masa tenggang menjadi satu-satunya tempo yang benar-benar diberikan kepada klien.
    -->
    <record id="param_due_days" model="ir.config_parameter">
      <field name="key">athera_billing.due_days</field>
      <field name="value">14</field>
    </record>

    <!--
      Alamat internal yang menerima salinan setiap surat penagihan. Kosong di repo: alamat operator
      adalah kenyataan lokal sebuah instalasi, bukan bagian dari produk.
    -->
    <record id="param_notify_email" model="ir.config_parameter">
      <field name="key">athera_billing.notify_email</field>
      <field name="value"></field>
    </record>

    <record id="param_pilot_tenants" model="ir.config_parameter">
      <field name="key">athera_billing.pilot_tenants</field>
      <field name="value"></field>
    </record>

    <!--
      Basis URL portal klien (ATHERA Insight), dipakai surat penagihan untuk memberi tahu klien
      KE MANA ia harus pergi. Isi dengan skema + host saja, tanpa lintasan dan tanpa garis miring
      di akhir; `/billing` ditambahkan oleh `account.move._compute_athera_portal_url`.

      Sengaja KOSONG di repo, dengan alasan yang sama seperti `email_from` di mail_template.xml:
      hostname sebuah instalasi adalah kenyataan lokal, bukan bagian dari produk, dan sebuah
      domain produksi yang di-hardcode di sini akan tetap bekerja setelah parameter yang
      seharusnya mengendalikannya dikosongkan — sehingga tidak ada yang pernah tahu bahwa
      konfigurasinya salah. Kosong berarti surat terkirim tanpa tautan, bukan surat berisi
      tautan ke tempat yang tidak ada.
    -->
    <record id="param_portal_url" model="ir.config_parameter">
      <field name="key">athera_billing.portal_url</field>
      <field name="value"></field>
    </record>
  </data>
</odoo>
