<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_labor_allocation" model="ir.sequence">
        <field name="name">Alokasi Gaji Pekerja Tetap</field>
        <field name="code">custom.spk.labor.allocation</field>
        <field name="prefix">ALOK/%(year)s/</field>
        <field name="padding">3</field>
        <field name="implementation">standard</field>
        <field name="use_date_range" eval="True"/>
    </record>

    <record id="cron_warn_unmapped_shifts" model="ir.cron">
        <field name="name">SPK: peringatkan shift harian yang belum di-mapping</field>
        <field name="model_id" ref="model_custom_spk_attendance"/>
        <field name="state">code</field>
        <field name="code">model._cron_warn_unmapped()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
