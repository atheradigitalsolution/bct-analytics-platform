<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_spk_attendance_list" model="ir.ui.view">
        <field name="name">custom.spk.attendance.list</field>
        <field name="model">custom.spk.attendance</field>
        <field name="arch" type="xml">
            <!--
                Editable list, and that is the whole point. One supervisor covers every
                workshop, so the realistic input is a single screen where a round of the
                shop floor is ticked off in one pass. A form per person per shift would
                not be filled in.
            -->
            <list string="Absensi Shift" editable="bottom"
                  decoration-warning="is_daily and attendance_status == 'hadir' and portion_total &lt; 1">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="shift_id"/>
                <field name="attendance_status"/>
                <field name="is_daily" string="Harian" readonly="1"/>
                <field name="portion_total" string="Porsi" readonly="1"/>
                <field name="overtime_hours" string="Lembur"/>
                <field name="shift_cost" readonly="1" optional="hide"
                       groups="custom_spk.group_spk_cost_viewer"/>
                <field name="currency_id" column_invisible="True"
                       groups="custom_spk.group_spk_cost_viewer"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_spk_attendance_form" model="ir.ui.view">
        <field name="name">custom.spk.attendance.form</field>
        <field name="model">custom.spk.attendance</field>
        <field name="arch" type="xml">
            <form string="Absensi Shift">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state == 'approved'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="date"/>
                            <field name="shift_id"/>
                            <field name="attendance_status"/>
                        </group>
                        <group>
                            <field name="is_daily" readonly="1"/>
                            <field name="labor_category" readonly="1"/>
                            <field name="overtime_hours"/>
                            <field name="supervisor_id" readonly="1"/>
                            <field name="shift_cost" readonly="1"
                                   groups="custom_spk.group_spk_cost_viewer"/>
                            <field name="currency_id" invisible="1"
                                   groups="custom_spk.group_spk_cost_viewer"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="not is_daily or attendance_status != 'hadir' or portion_total >= 1">
                        Shift harian ini belum mendarat di mana pun. Upahnya tetap jalan;
                        tambahkan work log sebelum approve.
                    </div>
                    <notebook>
                        <page string="Work Log" name="logs">
                            <field name="work_log_ids">
                                <list editable="bottom">
                                    <field name="target"/>
                                    <field name="spk_id" required="target == 'spk'"/>
                                    <field name="shift_portion"/>
                                    <field name="analytic_account_id" readonly="1" optional="hide"
                                           groups="custom_spk.group_spk_cost_viewer"/>
                                    <field name="labor_cost" readonly="1" optional="hide"
                                           groups="custom_spk.group_spk_cost_viewer"/>
                                    <field name="is_allocation_basis" readonly="1" optional="hide"/>
                                    <field name="currency_id" column_invisible="True"
                                           groups="custom_spk.group_spk_cost_viewer"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="portion_total" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_spk_attendance_search" model="ir.ui.view">
        <field name="name">custom.spk.attendance.search</field>
        <field name="model">custom.spk.attendance</field>
        <field name="arch" type="xml">
            <search string="Absensi">
                <field name="employee_id"/>
                <field name="shift_id"/>
                <filter name="daily" string="Pekerja Harian" domain="[('is_daily', '=', True)]"/>
                <filter name="unmapped" string="Belum di-mapping"
                        domain="[('is_daily', '=', True), ('attendance_status', '=', 'hadir'), ('work_log_ids', '=', False)]"/>
                <filter name="to_approve" string="Belum Approve"
                        domain="[('state', '!=', 'approved')]"/>
                <group expand="0" string="Group By">
                    <filter name="by_date" string="Tanggal" context="{'group_by': 'date'}"/>
                    <filter name="by_shift" string="Shift" context="{'group_by': 'shift_id'}"/>
                    <filter name="by_employee" string="Pekerja" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_spk_attendance" model="ir.actions.act_window">
        <field name="name">Absensi Shift</field>
        <field name="res_model">custom.spk.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
    </record>

    <record id="action_spk_work_log" model="ir.actions.act_window">
        <field name="name">Work Log per SPK</field>
        <field name="res_model">custom.spk.work.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
