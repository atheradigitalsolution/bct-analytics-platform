<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_spk" model="ir.ui.view">
        <field name="name">product.template.form.spk</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="SPK / Material" name="spk_material"
                      groups="custom_spk.group_spk_cost_viewer">
                    <group>
                        <group string="Klasifikasi">
                            <field name="x_spk_material_class"/>
                            <field name="x_spk_standard_usage"
                                   invisible="x_spk_material_class != 'b_consumable'"/>
                        </group>
                        <group string="Kebijakan Sisa"
                               invisible="x_spk_material_class != 'a_stock'">
                            <field name="x_spk_offcut_product_id"/>
                            <field name="x_spk_offcut_threshold_pct"/>
                            <field name="x_spk_offcut_valuation_pct"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
