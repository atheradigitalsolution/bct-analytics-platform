<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_spk_mr_form" model="ir.ui.view">
        <field name="name">custom.spk.material.request.form</field>
        <field name="model">custom.spk.material.request</field>
        <field name="arch" type="xml">
            <form string="Permintaan Material">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'to_approve'"/>
                    <button name="action_reject" type="object" string="Tolak"
                            invisible="state != 'to_approve'"/>
                    <button name="action_issue" type="object" string="Keluarkan"
                            class="btn-primary" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <div class="alert alert-warning" role="alert" invisible="not over_estimate">
                        Permintaan ini membawa SPK melewati estimasinya. Isi alasannya;
                        approval-nya naik ke Project Manager.
                    </div>
                    <group>
                        <group>
                            <field name="spk_id"/>
                            <field name="work_item"/>
                            <field name="requested_by"/>
                        </group>
                        <group>
                            <field name="over_estimate" readonly="1"/>
                            <field name="supervisor_id" readonly="1"/>
                            <field name="approval_date" readonly="1"/>
                            <field name="escalated_to_id" readonly="1"
                                   invisible="not escalated_to_id"/>
                            <field name="picking_id" readonly="1" invisible="not picking_id"/>
                        </group>
                    </group>
                    <field name="escalation_reason" placeholder="Kenapa melebihi estimasi..."
                           invisible="not over_estimate"/>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="uom_id"/>
                            <field name="qty_requested"/>
                            <field name="qty_approved"/>
                            <field name="qty_issued" readonly="1"/>
                            <field name="qty_estimated" readonly="1" string="Estimasi"/>
                            <field name="qty_taken_before" readonly="1" string="Sudah Diambil"/>
                            <field name="subtotal" readonly="1" sum="Total"
                                   groups="custom_spk.group_spk_cost_viewer"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer oe_right"
                           groups="custom_spk.group_spk_cost_viewer">
                        <field name="total_cost" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_spk_mr_list" model="ir.ui.view">
        <field name="name">custom.spk.material.request.list</field>
        <field name="model">custom.spk.material.request</field>
        <field name="arch" type="xml">
            <list string="Permintaan Material" decoration-warning="over_estimate">
                <field name="name"/>
                <field name="spk_id"/>
                <field name="work_item"/>
                <field name="requested_by"/>
                <field name="over_estimate" string="Lebih"/>
                <field name="total_cost" sum="Total" groups="custom_spk.group_spk_cost_viewer"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_spk_material_request" model="ir.actions.act_window">
        <field name="name">Permintaan Material</field>
        <field name="res_model">custom.spk.material.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
