<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_spk_return_form" model="ir.ui.view">
        <field name="name">custom.spk.material.return.form</field>
        <field name="model">custom.spk.material.return</field>
        <field name="arch" type="xml">
            <form string="Retur / Sisa Material">
                <header>
                    <button name="action_done" type="object" string="Booking"
                            class="btn-primary" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="spk_id"/>
                            <field name="returned_by"/>
                            <field name="date"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom" decoration-success="is_reusable">
                            <field name="product_id"/>
                            <field name="qty_returned"/>
                            <field name="remnant_share" string="Sisa % Unit"/>
                            <field name="is_reusable" readonly="1" string="Layak Pakai"/>
                            <field name="credit_amount" readonly="1" sum="Kredit"
                                   groups="custom_spk.group_spk_cost_viewer"/>
                            <field name="waste_amount" readonly="1" sum="Waste"
                                   groups="custom_spk.group_spk_cost_viewer"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer oe_right"
                           groups="custom_spk.group_spk_cost_viewer">
                        <field name="credit_total" readonly="1"/>
                        <field name="waste_total" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_spk_material_return" model="ir.actions.act_window">
        <field name="name">Retur / Sisa Material</field>
        <field name="res_model">custom.spk.material.return</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
