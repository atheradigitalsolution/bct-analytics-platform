<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_followup_level_list" model="ir.ui.view">
        <field name="name">custom.spk.followup.level.list</field>
        <field name="model">custom.spk.followup.level</field>
        <field name="arch" type="xml">
            <list string="Level Follow-up" editable="bottom">
                <field name="days_overdue"/>
                <field name="name"/>
                <field name="action"/>
                <field name="mail_template_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_followup_level" model="ir.actions.act_window">
        <field name="name">Level Follow-up Penagihan</field>
        <field name="res_model">custom.spk.followup.level</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_partner_form_spk_credit" model="ir.ui.view">
        <field name="name">res.partner.form.spk.credit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Piutang SPK" name="spk_credit"
                      groups="custom_spk.group_spk_price_viewer">
                    <group>
                        <field name="x_spk_overdue_amount" readonly="1"/>
                        <field name="x_spk_overdue_days" readonly="1"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
