<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_billing_plan_form" model="ir.ui.view">
        <field name="name">custom.spk.billing.plan.form</field>
        <field name="model">custom.spk.billing.plan</field>
        <field name="arch" type="xml">
            <form string="Rencana Penagihan">
                <header>
                    <button name="action_activate" type="object" string="Aktifkan"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="spk_id"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="mode"/>
                        </group>
                        <group>
                            <field name="contract_amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="block_production_until_dp"/>
                        </group>
                    </group>
                    <field name="milestone_ids" invisible="mode != 'milestone'">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="percentage"/>
                            <field name="amount" readonly="1" sum="Total"/>
                            <field name="trigger"/>
                            <field name="is_down_payment"/>
                            <field name="invoice_id" readonly="1"/>
                            <field name="is_paid" readonly="1"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer oe_right" invisible="mode != 'milestone'">
                        <field name="milestone_total_pct" readonly="1" string="Total %"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_billing_plan_list" model="ir.ui.view">
        <field name="name">custom.spk.billing.plan.list</field>
        <field name="model">custom.spk.billing.plan</field>
        <field name="arch" type="xml">
            <list string="Rencana Penagihan">
                <field name="name"/>
                <field name="spk_id"/>
                <field name="partner_id"/>
                <field name="mode"/>
                <field name="contract_amount" sum="Nilai"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_billing_plan" model="ir.actions.act_window">
        <field name="name">Rencana Penagihan</field>
        <field name="res_model">custom.spk.billing.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
