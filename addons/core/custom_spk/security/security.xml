<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Five groups, two axes. Who does the work (AE, supervisor, PM) is one axis;
        what money they may see (cost, price) is another. They are kept separate
        because they genuinely cross: a PM needs cost to manage a job and must not
        see the margin, while Finance needs both and manages nothing.

        The Account Executive is deliberately NOT given sales_team.group_sale_salesman.
        Without it there is no read access to sale.order, account.move or
        purchase.order at all, which is the only version of "the AE cannot see
        prices" that survives an export or a JSON-RPC call.
    -->
    <!--
        Odoo 19 puts res.groups.privilege between a group and its module category;
        res.groups.category_id no longer exists. Groups point at the privilege, the
        privilege points at the category.
    -->
    <record id="module_category_spk" model="ir.module.category">
        <field name="name">SPK / Job Costing</field>
        <field name="description">Surat Perintah Kerja and the access model around it.</field>
        <field name="sequence">22</field>
    </record>

    <record id="privilege_spk" model="res.groups.privilege">
        <field name="name">SPK / Job Costing</field>
        <field name="category_id" ref="module_category_spk"/>
        <field name="description">Who runs a job, and what money they may see.</field>
        <field name="sequence">22</field>
    </record>

    <record id="group_spk_ae" model="res.groups">
        <field name="name">SPK / Account Executive</field>
        <field name="privilege_id" ref="privilege_spk"/>
        <field name="comment">Handles the client and follows the job. Sees the SPK it is
named on, and no money anywhere.</field>
    </record>

    <record id="group_spk_supervisor" model="res.groups">
        <field name="name">SPK / Supervisor (Mandor)</field>
        <field name="privilege_id" ref="privilege_spk"/>
        <field name="comment">Runs the workshops. One person covers all of them in this
deployment, so there is no per-workshop rule to belong to.</field>
    </record>

    <record id="group_spk_cost_viewer" model="res.groups">
        <field name="name">SPK / Cost Visibility</field>
        <field name="privilege_id" ref="privilege_spk"/>
        <field name="comment">May read cost: product standard price, shift allowances,
analytic lines. Grants nothing about selling price.</field>
    </record>

    <record id="group_spk_pm" model="res.groups">
        <field name="name">SPK / Project Manager</field>
        <field name="privilege_id" ref="privilege_spk"/>
        <field name="implied_ids" eval="[(4, ref('group_spk_supervisor')), (4, ref('group_spk_cost_viewer'))]"/>
        <field name="comment">Schedules and monitors every job. Needs cost to do it;
still sees no selling price.</field>
    </record>

    <record id="group_spk_price_viewer" model="res.groups">
        <field name="name">SPK / Price and Margin Visibility</field>
        <field name="privilege_id" ref="privilege_spk"/>
        <field name="implied_ids" eval="[(4, ref('group_spk_cost_viewer'))]"/>
        <field name="comment">Owner and Finance. Margin is meaningless without cost, so
this implies cost visibility rather than sitting beside it.</field>
    </record>

    <!--
        Record rules. Odoo ORs rules across a user's groups for the same model, so an
        AE who also held a global rule would see everything. That is why the AE gets
        exactly one group and the rules below do not overlap.
    -->
    <record id="rule_spk_ae_own" model="ir.rule">
        <field name="name">SPK: an AE sees the jobs they are named on</field>
        <field name="model_id" ref="model_custom_spk"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_spk_ae'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_spk_all" model="ir.rule">
        <field name="name">SPK: supervisors and PMs see every job</field>
        <field name="model_id" ref="model_custom_spk"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_spk_supervisor')), (4, ref('group_spk_pm'))]"/>
    </record>
</odoo>
