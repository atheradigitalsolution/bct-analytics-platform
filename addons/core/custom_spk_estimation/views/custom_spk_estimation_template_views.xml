<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_spk_estimation_template_form" model="ir.ui.view">
        <field name="name">custom.spk.estimation.template.form</field>
        <field name="model">custom.spk.estimation.template</field>
        <field name="arch" type="xml">
            <form string="Template Estimasi">
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Booth 3x3 Standar"/></h1></div>
                    <group>
                        <group>
                            <field name="booth_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="overhead_rate"/>
                            <field name="risk_rate"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="work_item"/>
                            <field name="category"/>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                            <field name="unit_cost"/>
                            <field name="waste_pct"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <group>
                        <field name="note" placeholder="Catatan pemakaian template ini..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_spk_estimation_template" model="ir.actions.act_window">
        <field name="name">Template Estimasi</field>
        <field name="res_model">custom.spk.estimation.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
