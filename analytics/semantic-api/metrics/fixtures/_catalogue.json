{
  "metrics": [
    {
      "name": "ppob_commission_revenue",
      "label": "Pendapatan Komisi PPOB",
      "description": "Commission earned on PPOB transactions. This is the ONLY PPOB revenue measure. The much larger pass_through_amount on the same mart is money owed to the biller \u2014 it is not revenue, and the registry refuses any metric that sums it as an IDR amount.",
      "grain": [
        "date_day",
        "tenant_id",
        "operating_unit_id"
      ],
      "dimensions": [
        "date_day",
        "date_month",
        "tenant_id",
        "operating_unit_id",
        "biller_key",
        "biller_code",
        "biller_category"
      ],
      "filters": {
        "date_range": {
          "type": "daterange",
          "required": true,
          "column": "date_day"
        },
        "operating_unit_id": {
          "type": "int[]",
          "required": false
        },
        "biller_code": {
          "type": "string[]",
          "required": false
        }
      },
      "type": "decimal",
      "unit": "IDR",
      "aggregation": "sum",
      "refresh_sla_seconds": 60,
      "pdp_class": "internal",
      "source_model": "mart_ppob_transaction"
    },
    {
      "name": "ppob_sla_breach_count",
      "label": "Pelanggaran SLA PPOB",
      "description": "PPOB transactions that breached their biller SLA.",
      "grain": [
        "date_day",
        "tenant_id",
        "operating_unit_id"
      ],
      "dimensions": [
        "date_day",
        "date_month",
        "tenant_id",
        "operating_unit_id",
        "biller_key",
        "biller_code",
        "state"
      ],
      "filters": {
        "date_range": {
          "type": "daterange",
          "required": true,
          "column": "date_day"
        },
        "operating_unit_id": {
          "type": "int[]",
          "required": false
        },
        "biller_code": {
          "type": "string[]",
          "required": false
        }
      },
      "type": "count",
      "unit": null,
      "aggregation": "sum",
      "refresh_sla_seconds": 60,
      "pdp_class": "internal",
      "source_model": "mart_ppob_transaction"
    },
    {
      "name": "ppob_transaction_count",
      "label": "Jumlah Transaksi PPOB",
      "description": "Count of PPOB transactions. The 60-second SLA is the tightest in the platform because PPOB is operational: an SLA breach is the point of the view, not an inconvenience (ADR 0001).",
      "grain": [
        "date_day",
        "tenant_id",
        "operating_unit_id"
      ],
      "dimensions": [
        "date_day",
        "date_month",
        "tenant_id",
        "operating_unit_id",
        "biller_key",
        "biller_code",
        "biller_category",
        "state"
      ],
      "filters": {
        "date_range": {
          "type": "daterange",
          "required": true,
          "column": "date_day"
        },
        "operating_unit_id": {
          "type": "int[]",
          "required": false
        },
        "state": {
          "type": "string[]",
          "required": false
        },
        "biller_code": {
          "type": "string[]",
          "required": false
        }
      },
      "type": "count",
      "unit": null,
      "aggregation": "sum",
      "refresh_sla_seconds": 60,
      "pdp_class": "internal",
      "source_model": "mart_ppob_transaction"
    },
    {
      "name": "revenue_net",
      "label": "Pendapatan Neto",
      "description": "Invoiced revenue excluding tax, with credit notes netted off, plus POS takings and PPOB commission. Summed across all three revenue channels.",
      "grain": [
        "date_day",
        "tenant_id",
        "operating_unit_id"
      ],
      "dimensions": [
        "date_day",
        "date_month",
        "tenant_id",
        "operating_unit_id",
        "partner_key",
        "product_key",
        "company_id",
        "revenue_channel"
      ],
      "filters": {
        "date_range": {
          "type": "daterange",
          "required": true,
          "column": "date_day"
        },
        "operating_unit_id": {
          "type": "int[]",
          "required": false
        },
        "product_key": {
          "type": "string[]",
          "required": false
        },
        "revenue_channel": {
          "type": "string[]",
          "required": false
        }
      },
      "type": "decimal",
      "unit": "IDR",
      "aggregation": "sum",
      "refresh_sla_seconds": 900,
      "pdp_class": "internal",
      "source_model": "mart_revenue_daily"
    },
    {
      "name": "sales_total",
      "label": "Total Penjualan",
      "description": "Gross sales order value including tax, before invoicing.",
      "grain": [
        "date_day",
        "tenant_id",
        "operating_unit_id"
      ],
      "dimensions": [
        "date_day",
        "date_month",
        "tenant_id",
        "operating_unit_id",
        "partner_key",
        "product_key",
        "company_id"
      ],
      "filters": {
        "date_range": {
          "type": "daterange",
          "required": true,
          "column": "date_day"
        },
        "operating_unit_id": {
          "type": "int[]",
          "required": false
        },
        "product_key": {
          "type": "string[]",
          "required": false
        }
      },
      "type": "decimal",
      "unit": "IDR",
      "aggregation": "sum",
      "refresh_sla_seconds": 300,
      "pdp_class": "internal",
      "source_model": "mart_sales_daily"
    },
    {
      "name": "sales_untaxed",
      "label": "Penjualan Sebelum Pajak",
      "description": "Sales order value excluding tax.",
      "grain": [
        "date_day",
        "tenant_id",
        "operating_unit_id"
      ],
      "dimensions": [
        "date_day",
        "date_month",
        "tenant_id",
        "operating_unit_id",
        "partner_key",
        "product_key",
        "company_id"
      ],
      "filters": {
        "date_range": {
          "type": "daterange",
          "required": true,
          "column": "date_day"
        },
        "operating_unit_id": {
          "type": "int[]",
          "required": false
        }
      },
      "type": "decimal",
      "unit": "IDR",
      "aggregation": "sum",
      "refresh_sla_seconds": 300,
      "pdp_class": "internal",
      "source_model": "mart_sales_daily"
    },
    {
      "name": "stock_net_quantity",
      "label": "Posisi Stok",
      "description": "Net quantity moved (in minus out) by product and operating unit.",
      "grain": [
        "tenant_id",
        "operating_unit_id",
        "product_key"
      ],
      "dimensions": [
        "tenant_id",
        "operating_unit_id",
        "product_key",
        "product_id",
        "company_id"
      ],
      "filters": {
        "operating_unit_id": {
          "type": "int[]",
          "required": false
        },
        "product_key": {
          "type": "string[]",
          "required": false
        }
      },
      "type": "decimal",
      "unit": "unit",
      "aggregation": "sum",
      "refresh_sla_seconds": 300,
      "pdp_class": "internal",
      "source_model": "mart_stock_position"
    }
  ]
}
