# ===========================================================================
# odoo19-bct — environment template.
#
#   cp .env.example .env         # then edit by hand, OR
#   make dev-bootstrap           # generates .env with real random secrets
#
# EVERY SECRET IN THIS FILE IS THE LITERAL STRING `changeme`.
# That is deliberate and it is checked:
#   * `make scan-secret` fails if any tracked file carries a real-looking secret;
#   * odoo/render-config.py refuses to start Odoo with ODOO_ADMIN_PASSWD=changeme;
#   * postgres/init/00-init.sh refuses to initialise with a `changeme` password.
# A "plausible-looking" placeholder is worse than `changeme`, because it can be
# mistaken for a real value and shipped.
#
# .env is gitignored. .env.example is tracked. Do not swap them.
# ===========================================================================

# ---------------------------------------------------------------------------
# Compose
# ---------------------------------------------------------------------------
# odoo19-bct, NOT odoo19-platform: this host already runs odoo19-platform-* and
# odoo19-analytics-* stacks and they must not be touched. Every compose command
# in the Makefile is scoped with -p to this name.
COMPOSE_PROJECT_NAME=odoo19-bct

# Makes a bare `docker compose ps` / `logs` / `exec` resolve to the dev stack,
# so the documented commands work without repeating -f. COMPOSE_PATH_SEPARATOR
# is set explicitly because it defaults to ';' on Windows and ':' elsewhere.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
COMPOSE_PATH_SEPARATOR=:

TZ=Asia/Jakarta

# ---------------------------------------------------------------------------
# Host port block — 38xxx / 35xxx / 36xxx / 39xxx / 33xxx
#
# Bound to 127.0.0.1 ONLY, never 0.0.0.0. Ports 8069 and 5432 on this host are
# already taken by other stacks; so are 18xxx (odoo19-platform) and 2xxxx
# (odoo19-analytics). Do not move into those ranges.
#
# RESERVED for later agents — allocated here so nobody picks a bound port:
#   35433  warehouse postgres     (Data Warehouse agent)
#   38120  login-gateway          (Backend agent)
#   38200  semantic-api           (Backend agent)
#   33000  insight-portal         (Frontend agent)
# ---------------------------------------------------------------------------
ODOO_HOST_HTTP_PORT=38069
ODOO_HOST_LONGPOLLING_PORT=38072
POSTGRES_HOST_PORT=35432
REDIS_HOST_PORT=36379
GRAFANA_HOST_PORT=33001
PROMETHEUS_HOST_PORT=39090
ALERTMANAGER_HOST_PORT=39093
LOKI_HOST_PORT=33100
BIND_ADDRESS=127.0.0.1

# ---------------------------------------------------------------------------
# Postgres — Odoo OLTP primary
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=changeme

# The CDC / analytics identity. SELECT + REPLICATION only; it is structurally
# incapable of writing to Odoo (postgres/init/sql/20-roles.sql).
WAREHOUSE_READER_USER=warehouse_reader
WAREHOUSE_READER_PASSWORD=changeme

# postgres_exporter identity. pg_monitor only — stats and replication-slot
# state, no table data.
POSTGRES_EXPORTER_USER=metrics_exporter
POSTGRES_EXPORTER_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Odoo
# ---------------------------------------------------------------------------
ODOO_DB_HOST=postgres
ODOO_DB_PORT=5432
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=changeme
ODOO_DB_MAXCONN=32

# The default tenant database. scripts/tenant-provision.sh creates more.
ODOO_DB_NAME=bct
# Anchored both ends. Widening this exposes other tenants at the HTTP layer.
ODOO_DBFILTER=^bct$

# Master password (/web/database/manager). FileOnlyOption in Odoo: no CLI flag,
# no env var — odoo/render-config.py injects it into the rendered odoo.conf.
ODOO_ADMIN_PASSWD=changeme

# False hides the database manager and stops anonymous tenant enumeration.
ODOO_LIST_DB=False
# True makes Odoo trust X-Forwarded-* — required behind the reverse proxy.
ODOO_PROXY_MODE=True

ODOO_HTTP_PORT=8069
ODOO_LONGPOLLING_PORT=8072

# Sized for a dev box / single VPS. Worst case = ODOO_WORKERS * HARD limit;
# idle RSS is far lower. See docs/agents/contracts/04-platform.md for measured.
ODOO_WORKERS=2
ODOO_MAX_CRON_THREADS=1
ODOO_LIMIT_MEMORY_SOFT=1073741824
ODOO_LIMIT_MEMORY_HARD=1342177280
ODOO_LIMIT_REQUEST=8192
ODOO_LIMIT_TIME_CPU=120
ODOO_LIMIT_TIME_REAL=240
ODOO_LIMIT_TIME_REAL_CRON=300

ODOO_LOG_LEVEL=info
ODOO_WITHOUT_DEMO=True

ODOO_EMAIL_FROM=noreply@localhost
ODOO_SMTP_SERVER=localhost
ODOO_SMTP_PORT=25

# Modules installed by `make init-db`, and therefore by `make up-dev`.
#
# This shipped as `base,web` long after the five addons existed, and that is a
# definition-of-done failure, not a tidy-up: a fresh clone got no domain model,
# so `make up-analytics` died with
#     relation "pdp_field_classification" does not exist        (exit 2)
# and the only way anyone reached a working warehouse was by running
# `make install-modules MODULES=...` by hand after every cold start. QA
# reproduced that twice. Dependencies (sale_management, stock, account,
# point_of_sale, ...) are resolved by Odoo; only the leaves belong here.
#
# custom_demo_seed is in the list ON PURPOSE and it is not a contradiction of
# its own "never install in production" banner. Two separate facts:
#   * this file is the LOCAL DEV template - `cp .env.example .env`, or
#     `make dev-bootstrap`. There is no production env file in this repo, and a
#     production install set must drop custom_demo_seed.
#   * installing it is INERT. Safeguard 1 in its manifest: it generates nothing
#     at install time. Data appears only when demo.seed.generator.generate() is
#     called, which is `make seed-demo`, never a side effect of a bring-up.
ODOO_INIT_MODULES=custom_pdp_core,custom_pdp_masking,custom_operating_unit,custom_ppob,custom_demo_seed

# ---------------------------------------------------------------------------
# Dev-only login password for the Odoo USER ACCOUNTS
# ---------------------------------------------------------------------------
# Applied to `admin` and to every demo.*@contoh.invalid account custom_demo_seed
# creates, by scripts/set-dev-passwords.sh, which `make up-dev` runs on every
# bring-up and `make set-dev-passwords` runs on demand. `make dev-bootstrap`
# generates a real random value here; this file ships the placeholder, like
# every other secret.
#
# NOT the master password. ODOO_ADMIN_PASSWD above guards
# /web/database/manager; this is an ordinary login credential.
#
# WHY IT IS NOT ON render-config.py's changeme-refusal list
# --------------------------------------------------------
# That refusal is right for ODOO_ADMIN_PASSWD: a placeholder master password is
# a usable control plane - create, drop and restore any database - it exists
# whether or not anyone opted in, and there is no safe degraded mode. Failing
# closed is the only correct answer.
#
# Here, failing closed would not fail closed. Odoo boots regardless of this
# variable, so a refusal to APPLY it does not deny anyone a login; it leaves
# `admin` on Odoo's own default password, `admin`, which is strictly weaker than
# `changeme` and reachable by anyone who has ever seen an Odoo. A refusal that
# leaves the weaker credential standing is theatre, and blocking a whole
# bring-up over a dev convenience is hostile on top of being useless.
#
# So set-dev-passwords.sh applies whatever is configured, warns loudly when that
# is the placeholder, and guarantees the invariant that was actually broken:
# the running database always agrees with this file, and Odoo's default is never
# left standing. `make check-dev-passwords` asserts both halves, including the
# negative - that `admin`/`admin` is REFUSED.
#
# A wholesale `cp .env.example .env` cannot reach a running stack anyway:
# render-config.py refuses to start Odoo with ODOO_ADMIN_PASSWD=changeme and
# postgres/init/00-init.sh refuses a `changeme` POSTGRES_PASSWORD. Reaching a
# live stack with `changeme` here takes a deliberate partial edit.
BCT_DEV_USER_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_MAXMEMORY=128mb

# ---------------------------------------------------------------------------
# Observability (docker-compose.observability.yml — `make up-obs`)
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_ROOT_URL=http://127.0.0.1:33001/
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=2GB
LOKI_RETENTION_PERIOD=168h
ALERTMANAGER_SMTP_FROM=alerts@localhost
ALERTMANAGER_SMTP_SMARTHOST=localhost:25

# ---------------------------------------------------------------------------
# Backup / restore (scripts/tenant-backup.sh, scripts/tenant-restore.sh)
# ---------------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# ===========================================================================
# RESERVED BY CONTRACT — consumed by later agents, declared here so the names
# are fixed once and nobody renames them. Platform-Infra does not read these.
# ===========================================================================

# --- Contract 01, PDP field classification ---------------------------------
# Per-tenant HMAC salt for deterministic masking at load time. One per tenant
# database; the suffix is the uppercased tenant slug. Lives in SOPS in any
# environment above dev; `changeme` here, always.
# Rotating a salt invalidates historical joins — treat it as a migration.
WAREHOUSE_MASK_SALT_DEFAULT=changeme
WAREHOUSE_MASK_SALT_BCT=changeme

# --- Contract 02, session --------------------------------------------------
# login-gateway RS256 keypair. The gateway is the ONLY holder of the private
# key; every verifier fetches the public key from JWKS and therefore never
# holds signing material. Paths are inside the login-gateway container.
LOGIN_GATEWAY_JWT_ALGORITHM=RS256
LOGIN_GATEWAY_JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
LOGIN_GATEWAY_JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
LOGIN_GATEWAY_JWT_KID=changeme
LOGIN_GATEWAY_JWT_ISSUER=https://login-gateway.local/
LOGIN_GATEWAY_JWT_AUDIENCE=insight-portal
# LOGIN_GATEWAY_JWKS_URL was here and is deleted, not corrected. The gateway PUBLISHES
# JWKS (login-gateway/app/keys.py:123); it never fetches one, so a variable telling the
# producer where its own keys live has no meaning. Verifiers name it after themselves --
# see SEMANTIC_API_JWKS_URL below -- so this name could not have served a future consumer
# either. It had zero consumers and carried the wrong host, which is the worst pair: the
# next person to wire it up would have inherited a 401 indistinguishable from a forged
# token. If you have it in an existing .env, gen-env-secrets.py reports it as an orphan
# and leaves it alone; delete that line by hand.
LOGIN_GATEWAY_ACCESS_TOKEN_TTL=3600
LOGIN_GATEWAY_REFRESH_COOKIE_NAME=bct_refresh
LOGIN_GATEWAY_HOST_PORT=38120

# --- Warehouse (Data Warehouse agent, port 35433 reserved above) -----------
#
# THREE ROLES, NOT ONE, and the reason is Postgres row security: a SUPERUSER
# bypasses RLS unconditionally and no policy can stop it. If dbt and the
# dashboard shared the container's POSTGRES_USER, every tenant-isolation test
# in this project would pass while proving nothing.
#
#   WAREHOUSE_ADMIN_*  the container's POSTGRES_USER. Superuser. Runs the init
#                      DDL and the backups. Nothing queries data as it.
#   WAREHOUSE_DB_*     NOSUPERUSER NOBYPASSRLS. Owns the schemas; dbt connects
#                      as it and is subject to RLS on its own tables.
#   WAREHOUSE_LOADER_* NOSUPERUSER. Backend's CDC loader. INSERT into raw.*,
#                      read/write warehouse.pipeline_state, read
#                      warehouse.column_policy. No CREATE, no access to marts.
#   WAREHOUSE_RLS_*    NOSUPERUSER NOBYPASSRLS, SELECT only. The semantic-api's
#                      identity. With app.tenant_id unset it reads zero rows.
WAREHOUSE_DB=warehouse
WAREHOUSE_ADMIN_USER=warehouse_admin
WAREHOUSE_ADMIN_PASSWORD=changeme
WAREHOUSE_DB_USER=warehouse
WAREHOUSE_DB_PASSWORD=changeme
WAREHOUSE_LOADER_USER=warehouse_loader
WAREHOUSE_LOADER_PASSWORD=changeme
WAREHOUSE_RLS_USER=warehouse_rls
WAREHOUSE_RLS_PASSWORD=changeme
WAREHOUSE_HOST_PORT=35433
# dbt threads. 4 is right for a 1 GiB warehouse container; raising it raises
# concurrent work_mem allocations, not throughput.
DBT_THREADS=4

# --- Backend (Phase 3): login-gateway key rotation, security finding T-4 --------------------
# TWO signing keys are published in JWKS from day one. A single-key JWKS cannot be rotated without
# an outage: publish first and cached verifiers reject every token; sign first and they reject every
# token until they refetch. Rotation is then: flip LOGIN_GATEWAY_JWT_KID to the NEXT kid, restart,
# wait one access-token TTL, mint a fresh standby.
LOGIN_GATEWAY_JWT_NEXT_KID=changeme
LOGIN_GATEWAY_JWT_NEXT_PRIVATE_KEY_PATH=/run/secrets/jwt-next-private.pem
LOGIN_GATEWAY_JWT_NEXT_PUBLIC_KEY_PATH=/run/secrets/jwt-next-public.pem
LOGIN_GATEWAY_REFRESH_TOKEN_TTL=1209600
LOGIN_GATEWAY_ODOO_URL=http://odoo:8069
LOGIN_GATEWAY_ALLOWED_DATABASES=bct
# Secure defaults to 1. Set to 0 ONLY for local http development; a refresh cookie without Secure
# travels in the clear.
LOGIN_GATEWAY_COOKIE_SECURE=0
LOGIN_GATEWAY_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_GATEWAY_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_GATEWAY_RATE_LIMIT_LOCKOUT_SECONDS=900

# --- Backend (Phase 3): semantic-api --------------------------------------------------------
SEMANTIC_API_HOST_PORT=38200
# odoo19-bct-login-gateway, NOT login-gateway. There is no compose SERVICE for the
# gateway anywhere in this repo -- scripts/analytics/gateway-run.sh starts it with
# `docker run --name`, so the CONTAINER NAME is the only name Docker's embedded DNS
# answers, and `login-gateway` has never resolved here. This shipped wrong, and the
# failure is silent in the worst way: semantic-api cannot fetch JWKS, so it rejects
# every VALID token as HTTP 401 "Invalid token." -- a fresh clone would read that as
# its own login being broken. Measured A/B with one valid token: this value 200 rows=2,
# `login-gateway` 401.
SEMANTIC_API_JWKS_URL=http://odoo19-bct-login-gateway:8080/.well-known/jwks.json
SEMANTIC_API_JWT_ISSUER=https://login-gateway.local/
SEMANTIC_API_JWT_AUDIENCE=insight-portal
SEMANTIC_API_WAREHOUSE_HOST=warehouse-db
SEMANTIC_API_WAREHOUSE_PORT=5432
SEMANTIC_API_MAX_LIMIT=5000
