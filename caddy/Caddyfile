# ----- Login gateway -----------------------------------------------------
# Published under its own hostname so a browser can reach the refresh cookie's
# path on the same site as the portal when they are put behind one domain.
auth.{$ATHERA_DOMAIN:athera.localhost} {
	encode zstd gzip
	import site_tls

	reverse_proxy login-gateway:8080 {
		import app_headers
	}
}

# ----- Tenants -----------------------------------------------------------
# One block per provisioned client. `bct` is the internal tenant. Adding a
# client adds a block here; scripts/tenant-provision.sh prints the snippet.
# Written out rather than wildcarded — see the header.
bct.{$ATHERA_DOMAIN:athera.localhost} {
	encode zstd gzip
	import site_tls

	# Long-polling has its own port in Odoo and must not go to the HTTP
	# workers, or every bus subscription occupies a worker for its full
	# timeout and the instance stops answering ordinary requests.
	@longpoll path /longpolling/* /websocket
	handle @longpoll {
		reverse_proxy odoo:8072 {
			import odoo_headers
		}
	}

	handle {
		reverse_proxy odoo:8069 {
			import odoo_headers
		}
	}

	log {
		output stdout
		# `filter` wrapping json, NOT plain json. The SSO ticket travels in a query
		# string, so the edge writes it verbatim into `request>uri` -- and the edge is
		# the only place that records it on the same line as the client's real address
		# (`X-Forwarded-For`). Caddy already redacts `Set-Cookie` here, but that is its
		# built-in default and it does not extend to the URI; this has to be asked for.
		#
		# Applied to every site block rather than only the one that receives tickets:
		# the filter is inert where the parameter never appears, and a route that moves
		# later must not quietly reopen this.
		#
		# This stops the ticket being WRITTEN here. It does not touch the `Referer`
		# header or the client's browser history, and the Odoo access log keeps its own
		# copy. Central log shipping is filtered separately, in promtail.
		format filter {
			wrap json
			fields {
				request>uri query {
					replace ticket REDACTED
				}
			}
		}
		level INFO
	}
}

